---
export type IconName =
	| 'arrow-right'
	| 'arrow-up-right'
	| 'book-open'
	| 'compass'
	| 'database'
	| 'blocks'
	| 'wrench'
	| 'scale'
	| 'feather'
	| 'shield-check'
	| 'minus'
	| 'user'
	| 'code-2'
	| 'check'
	| 'pen-line'
	| 'handshake'
	| 'graduation-cap'
	| 'megaphone'
	| 'sprout'
	| 'mail'
	| 'rss'
	| 'github'
	| 'linkedin'
	| 'layout-grid'
	| 'eye'
	| 'trending-up'
	| 'message-square'
	| 'calendar'
	| 'refresh'
	| 'users'
	| 'user-plus'
	| 'mouse-pointer-click'
	| 'external-link'
	| 'download'
	| 'plus';

interface Props {
	name: IconName;
	class?: string;
	strokeWidth?: number;
}

const { name, class: className, strokeWidth = 2 } = Astro.props;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width={strokeWidth}
	stroke-linecap="round"
	stroke-linejoin="round"
	class={className}
	aria-hidden="true"
>
	{name === 'arrow-right' && <><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></>}
	{name === 'arrow-up-right' && <><path d="M7 7h10v10" /><path d="M7 17 17 7" /></>}
	{name === 'book-open' && <><path d="M12 7v14" /><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3Z" /></>}
	{name === 'compass' && <><circle cx="12" cy="12" r="10" /><path d="m16.24 7.76-2.12 6.36-6.36 2.12 2.12-6.36 6.36-2.12Z" /></>}
	{name === 'database' && <><ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" /><path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3" /></>}
	{name === 'blocks' && <><path d="m12 2 8 4.5v9L12 20l-8-4.5v-9Z" /><path d="m4 6.5 8 4.5 8-4.5M12 11v9" /><path d="m8 4.25 8 4.5v4.5" /></>}
	{name === 'wrench' && <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76Z" />}
	{name === 'scale' && <><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z" /><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z" /><path d="M7 21h10M12 3v18" /><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2" /></>}
	{name === 'feather' && <><path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5l6.74-6.76Z" /><path d="m16 8-14 14M17.5 15H9" /></>}
	{name === 'shield-check' && <><path d="M20 13c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V5l8-3 8 3v8Z" /><path d="m9 12 2 2 4-4" /></>}
	{name === 'minus' && <path d="M5 12h14" />}
	{name === 'user' && <><circle cx="12" cy="8" r="4" /><path d="M4 22a8 8 0 0 1 16 0" /></>}
	{name === 'code-2' && <><path d="m18 16 4-4-4-4M6 8l-4 4 4 4M14 4l-4 16" /></>}
	{name === 'check' && <path d="m20 6-11 11-5-5" />}
	{name === 'pen-line' && <><path d="M12 20h9" /><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z" /></>}
	{name === 'handshake' && <><path d="m11 17 2 2a1 1 0 1 0 3-3" /><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.8 5.8 0 0 1 7.06-.87l.47.28a2 2 0 0 1 1.42.6L21 8" /><path d="m21 3 1 11h-2M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3M3 4h8" /></>}
	{name === 'graduation-cap' && <><path d="M22 10 12 5 2 10l10 5 10-5Z" /><path d="M6 12v5c3 3 9 3 12 0v-5M22 10v6" /></>}
	{name === 'megaphone' && <><path d="m3 11 18-5v12L3 13v-2Z" /><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6M21 6V4M21 20v-2" /></>}
	{name === 'sprout' && <><path d="M7 20h10M10 20c5.5-2.5.8-6.4 3-10" /><path d="M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4.2 2.8-.5 4.4 0 5.5.8Z" /><path d="M14.1 6c1-.8 2.1-2 3-4-2.8.5-4.4 1.3-5.3 2.5-.8 1.1-1.2 2.6-1.1 4.6 2-.3 3.4-1.1 4.4-2.1Z" /></>}
	{name === 'mail' && <><rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-10 5L2 7" /></>}
	{name === 'rss' && <><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1" /></>}
	{name === 'github' && <><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5A4.8 4.8 0 0 0 9 18v4" /><path d="M9 18c-4.51 2-5-2-7-2" /></>}
	{name === 'linkedin' && <><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4V9h4v2a6 6 0 0 1 2-3Z" /><rect width="4" height="12" x="2" y="9" /><circle cx="4" cy="4" r="2" /></>}
	{name === 'layout-grid' && <><rect width="7" height="7" x="3" y="3" rx="1" /><rect width="7" height="7" x="14" y="3" rx="1" /><rect width="7" height="7" x="14" y="14" rx="1" /><rect width="7" height="7" x="3" y="14" rx="1" /></>}
	{name === 'eye' && <><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" /></>}
	{name === 'trending-up' && <><path d="M22 7 13.5 15.5 8.5 10.5 2 17" /><path d="M16 7h6v6" /></>}
	{name === 'message-square' && <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />}
	{name === 'calendar' && <><rect width="18" height="18" x="3" y="4" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></>}
	{name === 'refresh' && <><path d="M21 12a9 9 0 1 1-2.64-6.36" /><path d="M21 3v6h-6" /></>}
	{name === 'users' && <><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></>}
	{name === 'user-plus' && <><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M19 8v6M22 11h-6" /></>}
	{name === 'mouse-pointer-click' && <><path d="M14 4.1 12 6" /><path d="m5.1 8-2.9-.8" /><path d="m7.6 3.6-2.2-2.1" /><path d="m13.3 4.5 2.1-2.1" /><path d="m12.8 6.6 6.2-1.1" /><path d="m7 7 4.5 4.5 3.5 9.5 2.2-5.8 5.8-2-5.5-2.5L7 7Z" /></>}
	{name === 'external-link' && <><path d="M15 3h6v6" /><path d="m10 14 11-11" /><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /></>}
	{name === 'download' && <><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><path d="m7 10 5 5 5-5" /><path d="M12 15V3" /></>}
	{name === 'plus' && <><path d="M5 12h14" /><path d="M12 5v14" /></>}
</svg>
