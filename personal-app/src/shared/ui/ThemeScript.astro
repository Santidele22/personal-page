---
/**
 * Script inline de restauración de tema.
 * Aplica el tema guardado (o el preferido del sistema) en cuanto se parsea el
 * `<head>`: se mantiene `is:inline` para que corra antes del primer pintado y
 * evitar el flash de tema. Ya no escucha `astro:before-swap` porque la app no
 * usa `<ClientRouter />` (issue 41): cada navegación es una carga de documento
 * completa y vuelve a ejecutar este script.
 *
 * CSP: al ser un script de autor sin empaquetar, Astro no genera su hash. El
 * hash del contenido exacto entre las etiquetas vive en
 * `security.csp.scriptDirective.hashes` de `astro.config.mjs`; si el cuerpo
 * cambia, hay que recalcularlo (sha256 en base64) o el navegador lo bloquea.
 */
---

<script is:inline>
	(() => {
		const applyTheme = (root) => {
			try {
				const saved = localStorage.getItem('santi-theme');
				const dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
				root.classList.toggle('dark', dark);
				root.style.colorScheme = dark ? 'dark' : 'light';
			} catch {
				root.classList.remove('dark');
				root.style.colorScheme = 'light';
			}
		};

		applyTheme(document.documentElement);
	})();
</script>
