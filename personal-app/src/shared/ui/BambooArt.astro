		<path d="M112 240 C132 230 154 228 172 234 C152 244 132 250 116 250 C111 250 109 244 112 240 Z" opacity="0.5" />
		<path d="M100 254 C82 246 62 244 46 248 C62 256 80 262 94 262 C99 262 102 258 100 254 Z" opacity="0.35" />
	</g>
	<g transform="translate(196 176) rotate(-18)">
		<ellipse cx="-16" cy="-7" rx="17" ry="3.4" fill="currentColor" opacity="0.4" transform="rotate(-8)" />
		<ellipse cx="14" cy="-7" rx="17" ry="3.4" fill="currentColor" opacity="0.4" transform="rotate(8)" />
		<ellipse cx="-14" cy="-2" rx="14" ry="3" fill="currentColor" opacity="0.3" transform="rotate(6)" />
		<ellipse cx="12" cy="-2" rx="14" ry="3" fill="currentColor" opacity="0.3" transform="rotate(-6)" />
		<rect x="-3" y="-6" width="6" height="34" rx="3" fill="currentColor" opacity="0.85" />
		<circle cx="0" cy="-9" r="4.2" fill="currentColor" opacity="0.9" />
		<circle cx="0" cy="-9" r="1.8" fill="var(--aka)" />
	</g>
	<g transform="translate(224 296)">
		<rect x="0" y="0" width="26" height="26" rx="3" fill="var(--aka)" />
		<text x="13" y="18" text-anchor="middle" font-size="12" fill="#fdf8ee" style="font-family: var(--font-geist-mono)">&lt;/&gt;</text>
	</g>
