---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
const segments = Array.from({ length: 5 }, (_, index) => index);
---

<svg
	viewBox="0 0 280 340"
	role="img"
	aria-label="Ilustración sumi-e de bambú con un sol rojo y una libélula"
	class={className}
	preserveAspectRatio="xMidYMid meet"
>
	<circle cx="205" cy="78" r="40" fill="var(--aka)" opacity="0.9" />
	<g fill="currentColor" opacity="0.85">
		{segments.map((index) => <rect x="96" y={14 + index * 68} width="15" height="58" rx="6" />)}
	</g>
	{segments.map((index) => <rect x="93" y={68 + index * 68} width="21" height="4" rx="2" fill="currentColor" opacity="0.5" />)}
	<g fill="currentColor" opacity="0.45">
		{segments.map((index) => <rect x="140" y={-6 + index * 70} width="9" height="60" rx="4.5" />)}
	</g>
	<g fill="currentColor" opacity="0.3">
		{segments.map((index) => <rect x="62" y={2 + index * 70} width="6" height="60" rx="3" />)}
	</g>
	<g fill="currentColor">
		<path d="M104 44 C128 30 156 28 178 36 C152 46 128 52 108 52 C104 52 102 47 104 44 Z" opacity="0.8" />
		<path d="M100 58 C82 48 60 44 40 48 C58 58 78 64 96 64 C100 64 102 61 100 58 Z" opacity="0.55" />
