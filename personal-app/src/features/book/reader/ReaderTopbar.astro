---
interface Props {
	title: string | null;
	author: string | null;
	initialPage: number;
	initialPct: number;
}

const { title, author, initialPage, initialPct } = Astro.props;
---

	<header class="topbar" id="topbar">
		<a class="crumb" id="topBackLink" href="/lecturas/">← lecturas</a>
		<div class="ident">
			<h1>{title ?? 'Vigilia de lectura'}</h1>
			<p>{author ?? 'No encontrado'}</p>
		</div>
		<div
			class="prog"
			id="progSummary"
			aria-label={`Progreso de lectura: página ${initialPage}, ${initialPct} por ciento`}
		>
			<span class="top-timer-pill" id="topTimerPill" hidden aria-live="off">
				<i class="timer-dot" aria-hidden="true"></i>
				<span id="topTimerClock">00:00</span>
			</span>
			<span class="pg">PÁG <b id="progPage">{initialPage}</b> · <span id="progTotalPages">…</span></span>
			<span class="wire" aria-hidden="true"><i id="progWire"></i></span>
			<span class="pct" id="progPct">{initialPct}%</span>
		</div>
	</header>
