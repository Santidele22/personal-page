---
// View, chapter and timed-vigilia decks.
---

	<!-- Panel de tipografía y foco -->
	<aside class="view-deck" id="viewDeck" aria-label="Preferencias de lectura">
		<div class="vd-head">
			<span>Página y foco</span>
			<button type="button" id="viewClose">Cerrar</button>
		</div>
		<div class="vd-row">
			<span class="vd-label">Tamaño</span>
			<div class="vd-seg" role="group" aria-label="Tamaño de letra">
				<button type="button" id="fontDown" aria-label="Achicar letra">A-</button>
				<span class="vd-scale-val" id="fontPct">100%</span>
				<button type="button" id="fontUp" aria-label="Agrandar letra">A+</button>
			</div>
		</div>
		<div class="vd-row">
			<span class="vd-label">Tipografía</span>
			<div class="vd-seg" role="group" aria-label="Tipo de letra">
				<button type="button" data-pref-font="serif" aria-pressed="true">Serif</button>
				<button type="button" data-pref-font="sans" aria-pressed="false">Sans</button>
			</div>
		</div>
		<div class="vd-row">
			<span class="vd-label">Alineación</span>
			<div class="vd-seg" role="group" aria-label="Alineación del texto">
				<button type="button" data-pref-align="left" aria-pressed="true">Izquierda</button>
				<button type="button" data-pref-align="justify" aria-pressed="false">Justificada</button>
			</div>
		</div>
		<div class="vd-row">
			<span class="vd-label">Foco</span>
			<div class="vd-seg" role="group" aria-label="Intensidad del foco">
				<button type="button" data-pref-focus="wide" aria-pressed="true">Amplio</button>
				<button type="button" data-pref-focus="narrow" aria-pressed="false">Estrecho</button>
				<button type="button" data-pref-focus="off" aria-pressed="false">Apagado</button>
			</div>
		</div>
	</aside>

	<!-- Índice de capítulos -->
	<aside class="chapter-deck" id="chapterDeck" aria-label="Navegación por capítulos">
		<div class="deck-head">
			<span>Capítulos</span>
			<button type="button" id="chapterClose">Cerrar</button>
		</div>
		<div class="chapter-list" id="chapterList" role="list">
			<p class="chapter-empty">Cargando capítulos…</p>
		</div>
		<p class="deck-foot">teclas: [ / ] o h / l capítulo · c abrir índice · j / k mover en lista</p>
	</aside>

	<!-- Contador de lectura obligatoria -->
	<aside class="timer-deck" id="timerDeck" aria-label="Vigilia cronometrada">
		<div class="deck-head">
			<span>Vigilia cronometrada</span>
			<button type="button" id="timerClose">Cerrar</button>
		</div>

		<div id="timerSetupView">
			<p class="timer-desc">Elegí cuánto tiempo querés quedarte leyendo. Al iniciar, entra en pantalla completa y bloquea toda salida hasta 00:00 (si cambiás de pestaña, el reloj se pausa).</p>
			<div class="timer-presets" role="group" aria-label="Duraciones sugeridas">
				<button type="button" class="timer-preset" data-timer-preset="10" aria-pressed="false">10 min</button>
				<button type="button" class="timer-preset" data-timer-preset="20" aria-pressed="true">20 min</button>
				<button type="button" class="timer-preset" data-timer-preset="30" aria-pressed="false">30 min</button>
				<button type="button" class="timer-preset" data-timer-preset="45" aria-pressed="false">45 min</button>
			</div>
			<div class="timer-custom-row">
				<label for="timerCustomMinutes">Minutos</label>
				<input id="timerCustomMinutes" type="number" min="1" max="240" step="1" value="20" />
				<button type="button" class="timer-start-btn" id="timerStartBtn">Iniciar vigilia</button>
			</div>
			<p class="timer-stats" id="timerStatsNote" hidden></p>
		</div>

		<div id="timerRunningView" hidden>
			<div class="timer-status-row">
				<span class="timer-status-badge" id="timerStatusBadge">En curso</span>
			</div>
			<div class="timer-running-clock" id="timerClockDisplay">20:00</div>
			<div class="timer-bar" aria-hidden="true"><i id="timerBarFill"></i></div>
			<p class="timer-pause-note" id="timerPauseNote" hidden></p>
			<p class="timer-lock-note">Vigilia sellada · sin salida anticipada hasta completar el reloj.</p>
		</div>

		<div class="timer-chime-row">
			<span>Campana al terminar</span>
			<button type="button" class="timer-chime-toggle" id="timerChimeToggle" aria-pressed="true">Activa</button>
		</div>
	</aside>
