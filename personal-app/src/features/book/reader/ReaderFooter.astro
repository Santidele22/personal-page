---
// Toast and bottom control bar.
---

	<div class="toast" id="toast" role="status" aria-live="polite"></div>

	<footer class="bottombar" id="bottombar" aria-label="Controles de lectura">
		<p class="hint">seleccioná para subrayar · j / k línea · [ / ] o h / l capítulo · c capítulos · t vigilia · f inmersión · v foco</p>
		<div class="bottombar-row">
			<div class="session" aria-label="Sesión de lectura">
				<button class="save" type="button" id="saveBtn">
					<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 2h8l2 2v10H3z"/><path d="M5 2v4h6V2M5 14v-5h6v5"/></svg>
					<span id="saveLabel">Guardar progreso</span>
				</button>
				<a id="bottomBackLink" href="/#lectura" aria-label="Volver al inicio">
					<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5"/></svg>
					Volver al inicio
				</a>
				<button class="full" type="button" id="fullBtn" aria-pressed="false" aria-label="Pantalla completa (F)">
					<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 6V2h4M10 2h4v4M14 10v4h-4M6 14H2v-4"/></svg>
					<span class="full-lbl" id="fullLabel">Inmersión</span>
				</button>
			</div>

			<div class="bottombar-right">
				<div class="chapter-nav" role="group" aria-label="Navegación por capítulos">
					<button type="button" class="chap-step" id="prevChapterBtn" aria-label="Capítulo anterior ([ o h)" title="Capítulo anterior ([ o h)" disabled>‹</button>
					<button type="button" class="chap-open" id="chapterBtn" aria-expanded="false" aria-label="Abrir lista de capítulos (C)">
						<span id="chapterBtnLabel">Capítulos</span>
					</button>
					<button type="button" class="chap-step" id="nextChapterBtn" aria-label="Siguiente capítulo (] o l)" title="Siguiente capítulo (] o l)" disabled>›</button>
				</div>
				<button class="view-trigger timer-trigger" type="button" id="timerBtn" aria-expanded="false" aria-label="Vigilia cronometrada (T)">
					<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6"/><path d="M8 4.5V8l2.5 1.5"/></svg>
					<i class="timer-dot" id="timerBtnDot" hidden aria-hidden="true"></i>
					<span id="timerBtnLabel">Vigilia</span>
				</button>
				<button class="view-trigger" type="button" id="viewBtn" aria-expanded="false" aria-label="Tipografía y foco">
					<span>Aa · Foco</span>
				</button>
			</div>
		</div>
	</footer>
