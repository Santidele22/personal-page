---
// Blocking lock-in veil (shown if exiting fullscreen or reloading mid-vigilia)
// and session summary modal rendered upon completion.
---

	<div
		class="vigilia-veil"
		id="vigiliaLockVeil"
		role="alertdialog"
		aria-modal="true"
		aria-labelledby="vigiliaVeilTitle"
		hidden
	>
		<div class="vigilia-veil-card">
			<p class="vigilia-eyebrow">Vigilia sellada · reloj en pausa</p>
			<h2 id="vigiliaVeilTitle">Volvé a la lectura</h2>
			<div class="vigilia-veil-clock" id="vigiliaVeilClock">00:00</div>
			<p class="vigilia-veil-reason" id="vigiliaVeilReason">Saliste de pantalla completa. El reloj está pausado hasta que vuelvas.</p>
			<button type="button" class="vigilia-primary-btn" id="vigiliaResumeBtn">
				Retomar en pantalla completa
			</button>
		</div>
	</div>

	<div
		class="vigilia-summary-backdrop"
		id="vigiliaSummaryModal"
		role="dialog"
		aria-modal="true"
		aria-labelledby="vigiliaSummaryTitle"
		hidden
	>
		<div class="vigilia-summary-card">
			<p class="vigilia-eyebrow">Vigilia completada</p>
			<h2 id="vigiliaSummaryTitle">Sesión sellada</h2>
			<div class="vigilia-summary-grid">
				<div class="vigilia-summary-stat">
					<span class="stat-label">Tiempo</span>
					<strong class="stat-val" id="vigiliaSummaryDuration">0 min</strong>
				</div>
				<div class="vigilia-summary-stat">
					<span class="stat-label">Páginas</span>
					<strong class="stat-val" id="vigiliaSummaryPages">—</strong>
				</div>
				<div class="vigilia-summary-stat">
					<span class="stat-label">Progreso</span>
					<strong class="stat-val" id="vigiliaSummaryProgress">0%</strong>
				</div>
			</div>
			<p class="vigilia-summary-pauses" id="vigiliaSummaryPauses" hidden></p>
			<p class="vigilia-summary-save" id="vigiliaSummarySaveStatus" role="status" aria-live="polite">
				Guardando progreso…
			</p>
			<div class="vigilia-summary-actions">
				<button type="button" class="vigilia-primary-btn" id="vigiliaSummaryContinueBtn">
					Seguir leyendo
				</button>
				<a class="vigilia-secondary-link" id="vigiliaSummaryExitLink" href="/lecturas/">
					Volver a lecturas
				</a>
			</div>
		</div>
	</div>
