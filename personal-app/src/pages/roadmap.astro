---
import BaseLayout from '../app/layouts/BaseLayout.astro';
import { SITE_NAME } from '../app/config/site';
import { layoutRoadmapGraph, milestoneStatusLabel, overallProgress, type GraphEdge, type GraphNode } from '../entities/roadmap/format';
import type { RoadmapStage } from '../entities/roadmap/types';
import { fetchRoadmap, roadmapFallback } from '../features/roadmap/api/roadmap';
import EmptyState from '../shared/ui/EmptyState.astro';
import Icon from '../shared/ui/Icon.astro';

/* The roadmap is read while the server renders the page; the fallback is the
   content the page ships with (S8). A reachable but empty aggregate renders
   the empty state instead: the backend is then the only source of truth. */
const fetched = await fetchRoadmap(Astro.url.origin);
const roadmap = fetched ?? roadmapFallback;
const { stages, milestones } = roadmap;

const overall = overallProgress(stages);
const doneCount = stages.filter((stage) => stage.state === 'done').length;
const nowCount = stages.filter((stage) => stage.state === 'now').length;
const nowStages = stages.filter((stage) => stage.state === 'now');
const overallSummary = `${doneCount} de ${stages.length} etapas completadas${nowCount > 0 ? ` · ${nowCount} en curso` : ''}`;

/* The graph is generated from the stages alone (S6): `layoutRoadmapGraph`
   places any N stages on the trunk/branch grid and marks every edge
   done/live/future, and the coordinates below come out of that layout — the
   artboard's fixed seven-node drawing never appears as markup. */
const graph = layoutRoadmapGraph(stages);

const WIDTH = 1120;
const PAD_X = 88;
const R = 32;
const RING_R = 38;
const RING_C = 2 * Math.PI * RING_R;
const BRANCHED_ROWS = { top: 140, trunk: 300, bottom: 450 } as const;
const hasBranches = graph.nodes.some((node) => node.lane !== 'trunk');
const HEIGHT = hasBranches ? 560 : 360;

const round = (value: number) => Math.round(value * 10) / 10;
const columnX = (column: number) =>
	graph.columns <= 1 ? WIDTH / 2 : PAD_X + (column * (WIDTH - 2 * PAD_X)) / (graph.columns - 1);
const laneY = (lane: GraphNode['lane']) => (hasBranches ? BRANCHED_ROWS[lane] : 180);

type PositionedNode = GraphNode & { x: number; y: number; stage: RoadmapStage };
const nodes: PositionedNode[] = graph.nodes.map((node) => ({
	...node,
	x: round(columnX(node.column)),
	y: laneY(node.lane),
	stage: stages[node.index],
}));
const nodeByIndex = new Map(nodes.map((node) => [node.index, node]));

/* Straight segment on a row, cubic with horizontal tangents across lanes —
   the two edge shapes of artboard 03. */
const edgePath = (edge: GraphEdge): string => {
	const from = nodeByIndex.get(edge.from);
	const to = nodeByIndex.get(edge.to);
	if (!from || !to) return '';

	const x1 = round(from.x + R + 4);
	const x2 = round(to.x - R - 4);
	if (from.y === to.y) return `M ${x1} ${from.y} H ${x2}`;

	const midX = round((x1 + x2) / 2);
	return `M ${x1} ${from.y} C ${midX} ${from.y}, ${midX} ${to.y}, ${x2} ${to.y}`;
};

const edgeClass = (state: GraphEdge['state']) =>
	state === 'done' ? 'stroke-aka' : state === 'live' ? 'edge-live stroke-aka' : 'stroke-border';

const labelY = (node: PositionedNode) => (node.lane === 'top' ? node.y - 64 : node.y + 64);
const sublabelY = (node: PositionedNode) => (node.lane === 'top' ? node.y - 46 : node.y + 82);

const graphDescription = `Grafo del roadmap: ${doneCount} etapas completadas, ${nowCount} en progreso y ${stages.length - doneCount - nowCount} pendientes.`;

const title = `Roadmap — ${SITE_NAME}`;
const description =
	'La hoja de ruta de Santiago Delebecq como backend → web3 developer: cada etapa del camino como nodo de un grafo, el progreso actual y los próximos hitos.';
---

<BaseLayout title={title} description={description}>
	<section class="mx-auto max-w-6xl px-5 pt-14 sm:px-8 lg:pt-20" aria-labelledby="roadmap-title">
		<p class="flex items-center gap-3 text-[13px] font-medium tracking-[0.25em] text-muted-foreground">
			<Icon name="compass" class="size-4 text-aka" />
			HOJA DE RUTA
		</p>
		<h1 id="roadmap-title" class="mt-3 font-mincho text-4xl font-semibold tracking-tight sm:text-5xl">Backend → Web3, en progreso<span class="text-aka">.</span></h1>
		<p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-muted-foreground">
			Mi camino como grafo: cada nodo es una etapa y cada arista una dependencia real. El tronco backend se bifurca hacia cloud y web3, y vuelve a converger en la especialización.
		</p>
		<div class="mt-9 flex flex-wrap items-center gap-x-5 gap-y-3">
			<span class="font-mincho text-4xl font-semibold tracking-tight sm:text-5xl">{overall}<span class="text-aka">%</span></span>
			<span class="relative h-1 min-w-40 flex-1 bg-muted" role="img" aria-label={`Progreso total: ${overall}%`}>
				<span class="absolute inset-0 bg-aka" style={`width: ${overall}%`}></span>
			</span>
			<span class="text-[13px] text-muted-foreground">{overallSummary}</span>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-5 pb-16 sm:px-8 lg:pb-24" aria-label="Grafo del roadmap">
		{stages.length === 0 && (
			<EmptyState
				icon="compass"
				class="mt-14"
				title="Todavía no hay etapas en la hoja de ruta"
				description="Cuando el roadmap tenga etapas cargadas, acá vas a ver el grafo con el camino completo, su progreso y sus próximos hitos."
			/>
		)}
		{stages.length > 0 && (
			<div class="mt-14 border border-border bg-card px-5 pt-8">
				<div class="overflow-x-auto">
					<svg
						viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
						class="block h-auto w-full min-w-[720px]"
						role="img"
						aria-label={graphDescription}
					>
						{graph.edges.map((edge) => (
							<path
								d={edgePath(edge)}
								class={edgeClass(edge.state)}
								fill="none"
								stroke-width="2"
								stroke-dasharray={edge.state === 'future' ? '4 6' : undefined}
							/>
						))}
						{nodes.map((node) => (
							<g>
								{node.stage.state === 'done' && (
									<>
										<circle cx={node.x} cy={node.y} r={R} class="fill-aka" />
										<path d={`M ${node.x - 12} ${node.y} l 8 8 l 16 -16`} fill="none" stroke="#fdf8ee" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
									</>
								)}
								{node.stage.state === 'now' && (
									<>
										<circle cx={node.x} cy={node.y} r={R} class="fill-card stroke-aka" stroke-width="2.5" />
										<circle
											cx={node.x}
											cy={node.y}
											r={RING_R}
											class="stroke-aka"
											fill="none"
											stroke-width="3"
											stroke-dasharray={round(RING_C)}
											stroke-dashoffset={round(RING_C * (1 - node.stage.progress / 100))}
											transform={`rotate(-90 ${node.x} ${node.y})`}
										/>
										<text x={node.x} y={node.y + 5} text-anchor="middle" font-size="13" class="fill-aka font-mincho font-semibold">
											{node.stage.progress}%
										</text>
									</>
								)}
								{node.stage.state === 'next' && (
									<>
										<circle
											cx={node.x}
											cy={node.y}
											r={R}
											class="fill-card stroke-border"
											stroke-width="2.5"
											stroke-dasharray={node.lane === 'trunk' && node.index > 0 ? '5 5' : undefined}
										/>
										<text x={node.x} y={node.y + 5} text-anchor="middle" font-size="13" class="fill-muted-foreground">
											{String(node.index + 1).padStart(2, '0')}
										</text>
									</>
								)}
								<text x={node.x} y={labelY(node)} text-anchor="middle" font-size="16" class="fill-foreground font-mincho font-semibold">
									{node.stage.title}
								</text>
								<text x={node.x} y={sublabelY(node)} text-anchor="middle" font-size="11" class="fill-muted-foreground">
									{node.stage.techs.join(' · ')}
								</text>
							</g>
						))}
					</svg>
				</div>
				<div class="flex flex-wrap gap-x-7 gap-y-2 px-1 py-4 text-xs text-muted-foreground">
					<span class="inline-flex items-center gap-2"><b class="size-3 bg-aka"></b>Completada</span>
					<span class="inline-flex items-center gap-2"><b class="size-3 rounded-full border-2 border-aka"></b>En progreso (el anillo marca el %)</span>
					<span class="inline-flex items-center gap-2"><b class="size-3 rounded-full border-2 border-border"></b>Próxima</span>
					<span class="inline-flex items-center gap-2">
						<b class="size-3" style="background: repeating-linear-gradient(90deg, var(--aka) 0 4px, transparent 4px 7px)"></b>Arista activa
					</span>
				</div>
			</div>
		)}

		{nowStages.length > 0 && (
			<div class="mt-6 grid gap-4 sm:grid-cols-2">
				{nowStages.map((stage) => (
					<div class="flex items-center gap-4 border border-border bg-card p-5 transition-colors hover:border-aka/60 sm:p-6">
						<span class="shrink-0 font-mincho text-2xl font-semibold text-aka">{stage.progress}%</span>
						<div class="min-w-0 flex-1">
							<h2 class="font-mincho text-base font-semibold">Ahora: {stage.title}</h2>
							<p class="mt-1 text-[13px] leading-relaxed text-muted-foreground">{stage.summary}</p>
							<span class="relative mt-3 block h-[3px] bg-muted" role="img" aria-label={`Progreso de ${stage.title}: ${stage.progress}%`}>
								<span class="absolute inset-0 bg-aka" style={`width: ${stage.progress}%`}></span>
							</span>
						</div>
					</div>
				))}
			</div>
		)}

		{milestones.length > 0 && (
			<div class="mt-16">
				<p class="flex items-center gap-3 text-[13px] font-medium tracking-[0.25em] text-muted-foreground">
					<Icon name="trending-up" class="size-4 text-aka" />
					PRÓXIMOS HITOS
				</p>
				<h2 class="mt-3 font-mincho text-2xl font-semibold tracking-tight sm:text-3xl">Lo que sigue<span class="text-aka">.</span></h2>
				<ol class="mt-7">
					{milestones.map((milestone) => (
						<li class="grid gap-2 border-t border-border py-5 sm:grid-cols-[120px_1fr_auto] sm:items-baseline sm:gap-6">
							<span class="text-xs font-semibold tracking-[0.12em] text-aka">{milestone.quarter}</span>
							<span class="text-[15px] leading-relaxed">
								{milestone.title}
								<small class="mt-1 block text-[13px] text-muted-foreground">{milestone.summary}</small>
							</span>
							<span
								class:list={[
									'inline-flex w-fit items-center rounded-[3px] px-2 py-0.5 text-[11px] font-medium tracking-[0.08em] uppercase',
									milestone.status === 'now' ? 'bg-aka/10 text-aka' : 'bg-secondary text-muted-foreground',
								]}
							>
								{milestoneStatusLabel(milestone.status)}
							</span>
						</li>
					))}
				</ol>
			</div>
		)}
	</section>
</BaseLayout>

<style>
	/* Live edges flow toward the node they feed (artboard 03). The global
	   `prefers-reduced-motion` rule already neutralises every animation; the
	   media query below leaves the live edge as a static dashed line so the
	   meaning survives without movement. */
	.edge-live {
		stroke-dasharray: 10 8;
		animation: roadmap-edge-flow 1.2s linear infinite;
	}

	@keyframes roadmap-edge-flow {
		to {
			stroke-dashoffset: -18;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.edge-live {
			animation: none;
		}
	}
</style>
