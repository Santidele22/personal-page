---
import BaseLayout from '../app/layouts/BaseLayout.astro';
import { SITE_NAME } from '../app/config/site';
import ProjectCard from '../entities/project/ProjectCard.astro';
import { fetchProjectsPage } from '../features/project/api/projects';
import EmptyState from '../shared/ui/EmptyState.astro';
import Icon from '../shared/ui/Icon.astro';
import PaginationControls from '../shared/ui/PaginationControls.astro';
import { parseOffset } from '../shared/api/pagination';

/* Dedicated, paginated archive of projects (issue 47 S9). */
const PAGE_SIZE = 8;
const offset = parseOffset(Astro.url.searchParams.get('offset'));
const page = await fetchProjectsPage(Astro.url.origin, offset, PAGE_SIZE);

const title = `Proyectos — ${SITE_NAME}`;
const description = 'Todos los proyectos reales, con código abierto y sin promesas infladas: algunos en producción, otros todavía en el banco de trabajo.';
---

<BaseLayout title={title} description={description}>
	<section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 lg:py-20" aria-labelledby="proyectos-archive-title">
		<a
			href="/#proyectos"
			class="group inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-aka"
		>
			<Icon name="arrow-left" class="size-4" strokeWidth={2} />
			Volver al inicio
		</a>
		<p class="mt-6 flex items-center gap-3 text-[13px] font-medium tracking-[0.25em] text-muted-foreground">
			<Icon name="blocks" class="size-4 text-aka" />
			PROYECTOS
		</p>
		<h1 id="proyectos-archive-title" class="mt-3 font-mincho text-4xl font-semibold tracking-tight sm:text-5xl">Todos los proyectos</h1>
		<p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-muted-foreground">La lista completa de lo que construyo con las manos: código, demo y stack de cada uno.</p>

		{page === null && (
			<EmptyState
				icon="blocks"
				class="mt-10"
				title="No se pudieron cargar los proyectos"
				description="La API no respondió bien ahora mismo. Reintentá en unos minutos: el listado completo vuelve enseguida."
			/>
		)}
		{page !== null && page.total === 0 && (
			<EmptyState
				icon="blocks"
				class="mt-10"
				title="Todavía no hay proyectos"
				description="Están en el banco de trabajo: cuando uno salga, acá vas a ver el código, la demo y el stack de cada uno."
			/>
		)}
		{page !== null && page.total > 0 && page.items.length === 0 && (
			<p class="mt-10 border border-border bg-card p-6 text-sm text-muted-foreground">
				No hay proyectos en esta página. <a href="/proyectos/" class="font-medium text-aka hover:underline">Volver a la primera página</a>.
			</p>
		)}
		{page !== null && page.items.length > 0 && (
			<>
				<div class="mt-10 grid gap-6 lg:grid-cols-2">
					{page.items.map((project) => (
						<ProjectCard project={project} />
					))}
				</div>
				<PaginationControls basePath="/proyectos/" total={page.total} offset={page.offset} limit={PAGE_SIZE} />
			</>
		)}
	</section>
</BaseLayout>
