---
import BaseLayout from '../app/layouts/BaseLayout.astro';
import { SITE_NAME } from '../app/config/site';
import CertificateCard from '../entities/certificate/CertificateCard.astro';
import { fetchCertificatesPage } from '../features/certificate/api/certificates';
import EmptyState from '../shared/ui/EmptyState.astro';
import Icon from '../shared/ui/Icon.astro';
import PaginationControls from '../shared/ui/PaginationControls.astro';
import { parseOffset } from '../shared/api/pagination';

/* Dedicated, paginated archive of certificates (issue 47 S9): the URL owns
   the page (`?offset=N`), the server renders it, and the same card the
   landing uses carries its view-transition name across the navigation. */
const PAGE_SIZE = 9;
const offset = parseOffset(Astro.url.searchParams.get('offset'));
const page = await fetchCertificatesPage(Astro.url.origin, offset, PAGE_SIZE);

const title = `Certificados — ${SITE_NAME}`;
const description = 'Todos los certificados que fui sacando, con la plataforma o institución que los emitió y el enlace para verlos.';
---

<BaseLayout title={title} description={description}>
	<section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 lg:py-20" aria-labelledby="certificados-archive-title">
		<a
			href="/#certificados"
			class="group inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-aka"
		>
			<Icon name="arrow-left" class="size-4" strokeWidth={2} />
			Volver al inicio
		</a>
		<p class="mt-6 flex items-center gap-3 text-[13px] font-medium tracking-[0.25em] text-muted-foreground">
			<Icon name="graduation-cap" class="size-4 text-aka" />
			CERTIFICADOS
		</p>
		<h1 id="certificados-archive-title" class="mt-3 font-mincho text-4xl font-semibold tracking-tight sm:text-5xl">Todos los certificados</h1>
		<p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-muted-foreground">La lista completa de lo que fui certificando, con la emisión y el enlace a la institución.</p>

		{page === null && (
			<EmptyState
				icon="graduation-cap"
				class="mt-10"
				title="No se pudieron cargar los certificados"
				description="La API no respondió bien ahora mismo. Reintentá en unos minutos: el listado completo vuelve enseguida."
			/>
		)}
		{page !== null && page.total === 0 && (
			<EmptyState
				icon="graduation-cap"
				class="mt-10"
				title="Todavía no hay certificados"
				description="Cuando haya certificados cargados, acá vas a ver la imagen, la descripción, la fecha y el enlace a la institución que los emitió."
			/>
		)}
		{page !== null && page.total > 0 && page.items.length === 0 && (
			<p class="mt-10 border border-border bg-card p-6 text-sm text-muted-foreground">
				No hay certificados en esta página. <a href="/certificados/" class="font-medium text-aka hover:underline">Volver a la primera página</a>.
			</p>
		)}
		{page !== null && page.items.length > 0 && (
			<>
				<div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
					{page.items.map((certificate) => (
						<CertificateCard certificate={certificate} />
					))}
				</div>
				<PaginationControls basePath="/certificados/" total={page.total} offset={page.offset} limit={PAGE_SIZE} />
			</>
		)}
	</section>
</BaseLayout>
