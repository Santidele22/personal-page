			});
		});
		document.querySelectorAll<HTMLButtonElement>('[data-pref-align]').forEach((btn) => {
			btn.addEventListener('click', () => {
				prefs = { ...prefs, align: (btn.dataset.prefAlign as ReaderAlign) || 'left' };
				applyReaderPrefs(true);
			});
		});
		document.querySelectorAll<HTMLButtonElement>('[data-pref-focus]').forEach((btn) => {
			btn.addEventListener('click', () => {
				prefs = { ...prefs, focus: (btn.dataset.prefFocus as ReaderFocusMode) || 'wide' };
				applyReaderPrefs(true);
			});
		});

		// ===== Modo Zen (auto-ocultar cromo al leer) + Pantalla completa =====
		let zenTimer: ReturnType<typeof setTimeout> | undefined;
		let pointerOverChrome = false;

		function hasActiveOverlay(): boolean {
			return Boolean(
				viewDeck?.classList.contains('open') ||
					chapterDeck?.classList.contains('open') ||
					timerDeck?.classList.contains('open') ||
					selbar?.classList.contains('on'),
			);
		}

		function setZen(on: boolean) {
			if (on && (hasActiveOverlay() || pointerOverChrome)) {
				body.dataset.zen = 'off';
				return;
			}
			body.dataset.zen = on ? 'on' : 'off';
		}

		function wakeChrome(delayMs = 2500) {
			setZen(false);
			if (zenTimer) clearTimeout(zenTimer);
			zenTimer = setTimeout(() => {
				setZen(true);
			}, delayMs);
		}

		['#topbar', '#bottombar', '#viewDeck', '#chapterDeck', '#timerDeck', '#rail'].forEach((selector) => {
			const el = document.querySelector(selector);
			el?.addEventListener('pointerenter', () => {
				pointerOverChrome = true;
				wakeChrome(4000);
			});
			el?.addEventListener('pointerleave', () => {
				pointerOverChrome = false;
				wakeChrome(2200);
			});
		});

		document.addEventListener(
			'pointermove',
			(e) => {
				if (e.pointerType === 'touch') return;
				const nearTop = e.clientY <= 88;
				const nearBottom = e.clientY >= window.innerHeight - 108;
				if (nearTop || nearBottom || body.dataset.zen !== 'on') {
					wakeChrome(2500);
				}
			},
			{ passive: true },
		);

		let initialLoadSettled = false;
		setTimeout(() => {
			initialLoadSettled = true;
			wakeChrome(2500);
		}, 900);

		stage?.addEventListener(
			'scroll',
			() => {
				if (pendingLineJump && Math.abs(stage.scrollTop - pendingLineJump.targetTop) <= 4) {
					pendingLineJump = null;
				}
				if (renderedEnd < displayItems.length) {
					const remainingBottom = stage.scrollHeight - (stage.scrollTop + stage.clientHeight);
					if (remainingBottom < 1200) {
						appendNextBatch();
					}
				}
				if (renderedStart > 0 && stage.scrollTop < 900) {
					prependPrevBatch();
				}
				if (!initialLoadSettled) return;
				if (!hasActiveOverlay() && !pointerOverChrome) {
					if (zenTimer) clearTimeout(zenTimer);
					zenTimer = setTimeout(() => setZen(true), 450);
				}
			},
			{ passive: true },
		);

		async function toggleFullscreen() {
			try {
				if (!document.fullscreenElement) {
					await document.documentElement.requestFullscreen();
				} else {
					await document.exitFullscreen();
				}
			} catch {
				announce('pantalla completa no disponible en este navegador');
			}
		}

		function syncFullscreenButton() {
			const active = Boolean(document.fullscreenElement);
			fullBtn?.setAttribute('aria-pressed', String(active));
			if (fullLabel) fullLabel.textContent = active ? 'Salir' : 'Inmersión';
		}
		fullBtn?.addEventListener('click', () => {
			void toggleFullscreen();
		});
		document.addEventListener('fullscreenchange', syncFullscreenButton);

		function cycleFocusMode() {
			const order: ReaderFocusMode[] = ['wide', 'narrow', 'off'];
			const idx = order.indexOf(prefs.focus);
			const next = order[(idx + 1) % order.length];
			prefs = { ...prefs, focus: next };
			applyReaderPrefs(true);
			const label =
				next === 'wide' ? 'foco amplio' : next === 'narrow' ? 'foco estrecho' : 'página abierta';
			announce(`<b>${label}</b>`);
		}

		document.addEventListener('keydown', (e) => {
			if (e.ctrlKey || e.metaKey) return;
			if (e.altKey && !e.getModifierState?.('AltGraph')) return;
			const targetEl = e.target as HTMLElement | null;
			if (
				targetEl &&
				(targetEl.tagName === 'INPUT' ||
					targetEl.tagName === 'TEXTAREA' ||
					targetEl.tagName === 'SELECT' ||
					targetEl.isContentEditable)
			) {
				return;
			}
			const key = e.key.toLowerCase();
			if (key === 'escape') {
				if (hasActiveOverlay()) {
					closeAllDecks();
					hideSelbar();
					return;
				}
				setZen(body.dataset.zen !== 'on');
				return;
			}
			if (chapterDeck?.classList.contains('open')) {
				if (key === 'c') {
					e.preventDefault();
					closeChapterDeck();
					return;
				}
				if (key === 'j' || e.key === 'ArrowDown' || key === 'k' || e.key === 'ArrowUp') {
					e.preventDefault();
					const opts = Array.from(chapterList?.querySelectorAll<HTMLButtonElement>('.chapter-opt') ?? []);
					if (opts.length === 0) return;
					const focusedIdx = opts.indexOf(document.activeElement as HTMLButtonElement);
					const delta = key === 'j' || e.key === 'ArrowDown' ? 1 : -1;
					const fallbackIdx = Math.max(0, findActiveChapterIndex(chapters, currentItemIndex));
					const nextIdx =
						focusedIdx >= 0
							? (focusedIdx + delta + opts.length) % opts.length
							: fallbackIdx;
					opts[nextIdx]?.focus();
					return;
				}
			}
			if (key === 'j' || e.key === 'ArrowDown') {
				e.preventDefault();
				stepLine(1);
			} else if (key === 'k' || e.key === 'ArrowUp') {
				e.preventDefault();
				stepLine(-1);
			} else if (key === 'h' || e.key === '[') {
				e.preventDefault();
				stepChapter(-1);
			} else if (key === 'l' || e.key === ']') {
				e.preventDefault();
				stepChapter(1);
			} else if (key === 'c') {
				e.preventDefault();
				if (chapterDeck?.classList.contains('open')) closeChapterDeck();
				else openChapterDeck(true);
			} else if (key === 't') {
				e.preventDefault();
				if (timerDeck?.classList.contains('open')) closeTimerDeck();
				else openTimerDeck();
			} else if (e.key === ' ') {
				e.preventDefault();
				cancelSmoothScroll();
				stage?.scrollBy({
					top: (e.shiftKey ? -1 : 1) * Math.round(window.innerHeight * 0.55),
					behavior: 'smooth',
				});
			} else if (key === 'f') {
				e.preventDefault();
				void toggleFullscreen();
			} else if (key === 'v') {
				e.preventDefault();
				cycleFocusMode();
			}
		});

		const rawBookStatus = body.dataset.bookStatus;
		let bookStatus: ReadingStatus | '' =
			rawBookStatus === 'reading' || rawBookStatus === 'finished' || rawBookStatus === 'queued'
				? rawBookStatus
				: '';
		let hasStartedBook = false;
		let statusSyncPromise: Promise<void> | null = null;
		let pendingStatusSync = false;

		async function persistReadingState(): Promise<boolean> {
			writeLocalSnapshot();
			const pct = state.progress.pct || 0;
			try {
				await saveBookReadingState(bookId, {
					progress: state.progress,
					marks: state.marks,
					words: state.words,
				});
				const nextStatus = resolveAutoBookStatus(bookStatus, pct, true);
				if (nextStatus) {
					bookStatus = nextStatus;
					body.dataset.bookStatus = nextStatus;
				}
				return true;
			} catch {
				return false;
			}
		}

		async function syncAutoBookStatus(): Promise<void> {
			const targetStatus = resolveAutoBookStatus(
				bookStatus,
				state.progress.pct || 0,
				hasStartedBook,
			);
			if (!targetStatus) return;

			if (statusSyncPromise) {
				pendingStatusSync = true;
				return;
			}

			statusSyncPromise = (async () => {
				do {
					pendingStatusSync = false;
					const nextTarget = resolveAutoBookStatus(
						bookStatus,
						state.progress.pct || 0,
						hasStartedBook,
					);
					if (!nextTarget) break;

					const saved = await persistReadingState();
					if (!saved) break;

					if (nextTarget === 'finished') {
						announce('lectura completada · marcado automáticamente como <b>Terminado</b>');
					} else if (nextTarget === 'reading') {
						announce('lectura iniciada · marcado automáticamente como <b>Leyendo</b>');
					}
				} while (pendingStatusSync);
			})().finally(() => {
				statusSyncPromise = null;
			});

			await statusSyncPromise;
		}

		const saveBtn = document.getElementById('saveBtn');
		const saveLabel = document.getElementById('saveLabel');
		saveBtn?.addEventListener('click', async () => {
			const pg = progPage ? progPage.textContent : String(state.progress.page || 1);
			const pct = state.progress.pct || 0;
			const saved = await persistReadingState();
			if (!saved) {
				announce('no se pudo guardar en el servidor · revisá tu sesión de admin');
				return;
			}
			if (saveLabel) saveLabel.textContent = 'Guardado · pág ' + pg;
			saveBtn.classList.add('saved');
			announce(`progreso sellado · <b>pág ${pg} · ${pct}%</b> — te espera donde lo dejaste`);
			setTimeout(() => {
				if (saveLabel) saveLabel.textContent = 'Guardar progreso';
				saveBtn.classList.remove('saved');
			}, 3000);
		});

		const selbar = document.getElementById('selbar');
		const rail = document.getElementById('rail');
		const delMarkBtn = document.getElementById('delMarkBtn') as HTMLButtonElement | null;
		const delSep = document.getElementById('delSep');
		const kwBtn = document.getElementById('kwBtn') as HTMLButtonElement | null;
		const kwSep = document.getElementById('kwSep');

		let selRange: Range | null = null;
		let activeEditSpan: HTMLSpanElement | null = null;

		function placeSelbarAtRect(r: DOMRect) {
			if (!selbar) return;
			selbar.classList.add('on');
			const bw = selbar.offsetWidth || 180;
			selbar.style.left =
				Math.max(20, Math.min(r.left + r.width / 2 - bw / 2, innerWidth - bw - 20)) + 'px';
			selbar.style.top = Math.max(70, r.top - 48) + 'px';
		}

		function hideSelbar() {
			selbar?.classList.remove('on');
			activeEditSpan = null;
			selRange = null;
		}

		function findIntersectingSubOrKw(range: Range): HTMLSpanElement | null {
			if (!readerArticle) return null;
			const spans = readerArticle.querySelectorAll<HTMLSpanElement>('.sub, .kw');
			for (const span of spans) {
				try {
					if (range.intersectsNode(span)) return span;
				} catch {}
			}
			return null;
		}

		function openEditBarForSpan(span: HTMLSpanElement) {
			activeEditSpan = span;
			selRange = null;
			const isKeyword = span.classList.contains('kw');
			if (kwBtn && kwSep) {
				kwBtn.hidden = isKeyword;
				kwSep.hidden = isKeyword;
			}
			if (delMarkBtn && delSep) {
				delMarkBtn.hidden = false;
				delSep.hidden = false;
			}
			placeSelbarAtRect(span.getBoundingClientRect());
		}

		function positionSelbar() {
			const s = window.getSelection();
			if (!s || s.isCollapsed || s.rangeCount === 0 || !selbar) {
				if (!activeEditSpan) selbar?.classList.remove('on');
				return;
			}
			const range = s.getRangeAt(0);
			if (!readerArticle?.contains(range.commonAncestorContainer)) {
				if (!activeEditSpan) selbar.classList.remove('on');
				return;
			}
			const r = range.getBoundingClientRect();
			if (!r.width) {
				if (!activeEditSpan) selbar.classList.remove('on');
				return;
			}
			activeEditSpan = null;
			selRange = range;
			const existingMatch = findIntersectingSubOrKw(range);
			if (delMarkBtn && delSep) {
				const showDel = Boolean(existingMatch);
				delMarkBtn.hidden = !showDel;
				delSep.hidden = !showDel;
			}
			if (kwBtn && kwSep) {
				kwBtn.hidden = false;
				kwSep.hidden = false;
			}
			placeSelbarAtRect(r);
		}

		document.addEventListener('selectionchange', positionSelbar);
		document.addEventListener('pointerdown', (e) => {
			const target = e.target as Element | null;
			if (viewDeck?.classList.contains('open') && !target?.closest('#viewDeck, #viewBtn')) {
				closeViewDeck();
			}
			if (chapterDeck?.classList.contains('open') && !target?.closest('#chapterDeck, #chapterBtn')) {
				closeChapterDeck();
			}
			if (timerDeck?.classList.contains('open') && !target?.closest('#timerDeck, #timerBtn, #topBackLink, #bottomBackLink')) {
				closeTimerDeck();
			}
			if (!activeEditSpan) return;
			if (target?.closest('#selbar, .sub, .kw')) return;
			hideSelbar();
		});
		addEventListener(
			'scroll',
			() => {
				if (!selbar?.classList.contains('on')) return;
				if (activeEditSpan) {
					if (!activeEditSpan.isConnected) {
						hideSelbar();
					} else {
						placeSelbarAtRect(activeEditSpan.getBoundingClientRect());
					}
					return;
				}
				positionSelbar();
			},
			true,
		);

		function unwrapSpan(span: HTMLSpanElement) {
			const parent = span.parentNode;
			if (!parent) return;
			while (span.firstChild) {
				parent.insertBefore(span.firstChild, span);
			}
			parent.removeChild(span);
			parent.normalize();
		}

		function removeSpanAndState(span: HTMLSpanElement) {
			const spans = companionSpans(span);
			const hostPara = span.closest<HTMLElement>('[data-chunk-id]');
			const chunkId = hostPara?.dataset.chunkId;
			const text = annotationText(span);

			if (span.classList.contains('kw')) {
				const term = (span.dataset.wordTerm || text).trim();
				state.words = removeWordFromState(state.words, { term, anchor: chunkId });
				spans.forEach((part) => unwrapSpan(part));
				const stillHasTerm = state.words.some((w) => w.term.trim() === term);
				if (!stillHasTerm) {
					rail?.querySelector(`.rail-item[data-term="${CSS.escape(term)}"]`)?.remove();
				}
				void persistReadingState();
				announce('keyword borrada del margen');
				return;
			}

			state.marks = removeMarkFromState(state.marks, {
				id: span.dataset.markId,
				chunkId,
				text,
			});
			spans.forEach((part) => unwrapSpan(part));
			void persistReadingState();
			announce('subrayado borrado');
		}

		function wrapSelection(
			cls: string,
		): { span: HTMLSpanElement; text: string; chunkId: string } | null {
			if (!selRange) return null;
			try {
				const node = selRange.commonAncestorContainer;
				const hostPara =
					node.nodeType === 1
						? (node as Element).closest<HTMLElement>('[data-chunk-id]')
						: node.parentElement?.closest<HTMLElement>('[data-chunk-id]');
				const chunkId = hostPara?.dataset?.chunkId || 'p0001.0000';
				const span = document.createElement('span');
				span.className = cls;
				span.appendChild(selRange.extractContents());
				selRange.insertNode(span);
				const text = (span.textContent || '').trim();
				return { span, text, chunkId };
			} catch {
				return null;
			}
		}

		readerArticle?.addEventListener('click', (e) => {
			const sel = window.getSelection();
			if (sel && !sel.isCollapsed) return;

			const target = e.target as Element | null;
			const tocBtn = target?.closest<HTMLButtonElement>('.toc-item');
			if (tocBtn) {
				const targetLabel = tocBtn.dataset.tocLabel || '';
				const targetPage = Number(tocBtn.dataset.tocPage || 0);
				const targetIdx = findTocJumpTargetIndex(displayItems, targetLabel, targetPage);
				if (targetIdx !== null) {
					ensureItemRenderedAndScroll(targetIdx, 'smooth');
					announce(`saltando a · <b>${escapeHtml(targetLabel)}</b>`);
				} else {
					announce('sección no localizada en el texto extraído');
				}
				return;
			}

			const markEl = target?.closest<HTMLSpanElement>('.sub, .kw');
			if (markEl) {
				openEditBarForSpan(markEl);
				return;
			}

			const para = target?.closest<HTMLElement>(
				'#readerArticle p[data-chunk-id], #readerArticle blockquote[data-chunk-id], #readerArticle .reader-list[data-chunk-id], #readerArticle pre.reader-code[data-chunk-id]',
			);
			if (para && !target?.closest('a, button')) {
				const stageRect = stage?.getBoundingClientRect();
				const pRect = para.getBoundingClientRect();
				if (stageRect) {
					const ratio = prefs.focus === 'narrow' ? 0.29 : 0.22;
					const focusTop = stageRect.top + stageRect.height * ratio;
					const focusBottom = focusTop + (prefs.focus === 'narrow' ? 140 : 280);
					if (pRect.top < focusTop - 16 || pRect.top > focusBottom) {
						scrollElementToFocalBand(para, 'smooth');
					} else if (window.matchMedia('(pointer: coarse)').matches) {
						setZen(body.dataset.zen !== 'on');
					}
				}
			}
		});

		delMarkBtn?.addEventListener('click', () => {
			const targetSpan =
				activeEditSpan ?? (selRange ? findIntersectingSubOrKw(selRange) : null);
			if (targetSpan) {
				removeSpanAndState(targetSpan);
			}
			window.getSelection()?.removeAllRanges();
			hideSelbar();
		});

		selbar?.querySelectorAll<HTMLButtonElement>('.ink').forEach((btn) => {
			btn.addEventListener('click', () => {
				const inkAttr = btn.dataset.ink || 'sub-aka';
				const inkName = inkAttr.replace(/^sub-/, '') as 'aka' | 'bronce' | 'tinta';

				if (activeEditSpan && activeEditSpan.classList.contains('sub')) {
					companionSpans(activeEditSpan).forEach((part) => {
						part.classList.remove('sub-aka', 'sub-bronce', 'sub-tinta');
						part.classList.add(inkAttr);
					});
					const markId = activeEditSpan.dataset.markId;
					const text = annotationText(activeEditSpan);
					const chunkId = activeEditSpan.closest<HTMLElement>('[data-chunk-id]')?.dataset.chunkId;
					const existing = state.marks.find(
						(m) =>
							(markId && m.id === markId) ||
							((m.text || '').trim() === text &&
								(!chunkId || String(m.anchor || '').split('+')[0] === chunkId)),
					);
					if (existing) {
						existing.ink = inkName;
					}
					void persistReadingState();
					announce('tinta actualizada');
					hideSelbar();
					return;
				}

				const wrapped = wrapSelection('sub ' + inkAttr);
				if (wrapped && wrapped.text) {
					const markId = 'm-' + Date.now();
					wrapped.span.dataset.markId = markId;
					state.marks.push({
						id: markId,
						kind: 'underline',
						ink: inkName,
						anchor: `${wrapped.chunkId}+[0,${wrapped.text.length}]`,
						text: wrapped.text,
					});
					void persistReadingState();
					announce('subrayado en tinta · <b>cuaderno de márgenes</b>');
				}
				window.getSelection()?.removeAllRanges();
				hideSelbar();
			});
		});

		kwBtn?.addEventListener('click', () => {
			if (activeEditSpan && activeEditSpan.classList.contains('sub')) {
				const t = annotationText(activeEditSpan);
				if (t) {
					const chunkId =
						activeEditSpan.closest<HTMLElement>('[data-chunk-id]')?.dataset.chunkId ||
						'p0001.0000';
					appendRailWordItem(t, true);
					state.words.push({ term: t, anchor: chunkId });
					void persistReadingState();
					const short = t.length > 30 ? t.slice(0, 30) + '…' : t;
					announce('◇ keyword · <b>' + short + '</b> → riel del capítulo');
				}
				hideSelbar();
				return;
			}
			const wrapped = wrapSelection('kw');
			if (wrapped && wrapped.text) {
				const t = wrapped.text;
				wrapped.span.dataset.wordTerm = t;
				const short = t.length > 30 ? t.slice(0, 30) + '…' : t;
				appendRailWordItem(t, true);
				state.words.push({
					term: t,
					anchor: wrapped.chunkId,
				});
				void persistReadingState();
				announce('◇ keyword · <b>' + short + '</b> → riel del capítulo');
			}
			window.getSelection()?.removeAllRanges();
			hideSelbar();
		});

		rail?.addEventListener('click', (e) => {
			const target = e.target as Element | null;
			const removeBtn = target?.closest<HTMLButtonElement>('button[data-remove-word]');
			if (removeBtn) {
				const term = (removeBtn.dataset.removeWord || '').trim();
				if (!term) return;
				state.words = removeWordFromState(state.words, { term });
				removeBtn.closest('.rail-item')?.remove();
				document.querySelectorAll<HTMLSpanElement>('.kw').forEach((kw) => {
					const kwTerm = (kw.dataset.wordTerm || kw.textContent || '').trim();
					if (kwTerm === term) unwrapSpan(kw);
