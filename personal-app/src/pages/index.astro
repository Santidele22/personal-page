---
import BaseLayout from '../app/layouts/BaseLayout.astro';
import { showServicesOnLanding } from '../app/config/sections';
import AdBand from '../entities/ad-slot/AdBand.astro';
import { fetchAdvertisingPlans, fetchBrands } from '../features/admin/api/collections';
import { composeAdBands } from '../features/ad-slot/api/carrusel';
import Reveal from '../shared/ui/Reveal.astro';
import About from '../widgets/about/About.astro';
import Blog from '../widgets/blog/Blog.astro';
import Contact from '../widgets/contact/Contact.astro';
import Hero from '../widgets/hero/Hero.astro';
import Projects from '../widgets/projects/Projects.astro';
import Reading from '../widgets/reading/Reading.astro';
import Services from '../widgets/services/Services.astro';

/* The hero advertising band is composed while the server renders the page.
   Plans and brands are read in parallel; a failed request becomes `null`, the
   composition's fallback path, exactly like the other landing loaders. */
const serverOrigin = Astro.url.origin;
const [plans, brands] = await Promise.all([
	fetchAdvertisingPlans(serverOrigin).catch(() => null),
	fetchBrands(serverOrigin).catch(() => null),
]);
const bands = composeAdBands({ plans, brands, now: new Date() });
---

<BaseLayout>
	<Hero />
	<Reveal>
		<div class="mx-auto max-w-6xl px-5 sm:px-8">
			<AdBand band={bands.hero} />
		</div>
	</Reveal>
	<Blog />
	<About />
	<Projects />
	<Reading />
	{showServicesOnLanding && <Services />}
	<Contact />
</BaseLayout>
