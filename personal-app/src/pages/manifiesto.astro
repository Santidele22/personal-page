---
import BaseLayout from '../app/layouts/BaseLayout.astro';
import Icon from '../shared/ui/Icon.astro';
import { renderMarkdown } from '../shared/lib/markdown';
import {
	fetchManifesto,
	MANIFIESTO_CONTENT,
	MANIFIESTO_DESCRIPTION,
	MANIFIESTO_TITLE,
} from '../features/manifiesto/api';

/* The manifiesto is a reserved blog article (codex-copy S6): the panel edits
   it with the full-page diario editor and this page serves the stored copy
   on demand. While nobody saved the article (or the backend is down) the
   page renders the source-controlled default, so it never renders empty. */
const stored = await fetchManifesto(Astro.url.origin);

const title = stored?.title ?? MANIFIESTO_TITLE;
const description = stored?.description ?? MANIFIESTO_DESCRIPTION;
const html = renderMarkdown(stored?.content ?? MANIFIESTO_CONTENT);
---

<BaseLayout title={`Manifiesto · devlog.`} description={description}>
	<section class="mx-auto max-w-3xl px-5 py-16 sm:px-8 lg:py-24">
		<p class="flex items-center gap-3 text-[13px] font-medium tracking-[0.25em] text-muted-foreground">
			<Icon name="feather" class="size-4 text-aka" />
			MANIFIESTO
		</p>
		<h1 class="mt-3 font-mincho text-4xl font-semibold tracking-tight sm:text-5xl">
			{title}
		</h1>
		<p class="mt-6 max-w-xl text-[15px] leading-relaxed text-muted-foreground sm:text-base">
			{description}
		</p>

		<article
			class="mt-12 max-w-none [&_blockquote]:border-l-2 [&_blockquote]:border-aka [&_blockquote]:font-mincho [&_blockquote]:pl-5 [&_h2]:mt-12 [&_h2]:font-mincho [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:sm:text-3xl [&_h3]:mt-8 [&_h3]:font-mincho [&_h3]:text-xl [&_h3]:font-semibold [&_li]:text-[15px] [&_li]:leading-relaxed [&_li]:text-muted-foreground [&_ol]:mt-6 [&_ol]:list-decimal [&_ol]:space-y-4 [&_ol]:pl-6 [&_p]:mt-5 [&_p]:text-[15px] [&_p]:leading-relaxed [&_p]:text-muted-foreground [&_strong]:font-semibold [&_strong]:text-foreground [&_ul]:mt-6 [&_ul]:space-y-4"
			set:html={html}
		/>

		<a href="/" class="mt-12 inline-flex items-center gap-2 text-sm font-medium text-aka hover:underline">
			<Icon name="arrow-right" class="size-4 rotate-180" />
			Volver a la portada
		</a>
	</section>
</BaseLayout>
