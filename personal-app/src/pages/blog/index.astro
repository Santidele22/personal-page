---
// The archive is read from the backend on every request (issue 28): the
// admin panel publishes entries that must appear without a rebuild.
import BaseLayout from '../../app/layouts/BaseLayout.astro';
import FormattedDate from '../../shared/ui/FormattedDate.astro';
import Icon from '../../shared/ui/Icon.astro';
import { fetchBlogRows, toPost } from '../../features/blog/api/blogs';

const rows = await fetchBlogRows(Astro.url.origin);
const posts = rows.map((row) => toPost(row));
---

<BaseLayout title="Archivo del diario · santi." description="Todas las entradas del diario de Santi sobre backend, blockchain e ingeniería de software.">
	<section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 lg:py-20" aria-labelledby="archive-title">
		<a
			href="/"
			class="group inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-aka"
		>
			<Icon name="arrow-left" class="size-4" strokeWidth={2} />
			Volver al inicio
		</a>
		<p class="mt-6 flex items-center gap-3 text-[13px] font-medium tracking-[0.25em] text-muted-foreground">
			<Icon name="book-open" class="size-4 text-aka" />
			EL DIARIO
		</p>
		<h1 id="archive-title" class="mt-3 font-mincho text-4xl font-semibold tracking-tight sm:text-5xl">Archivo de entradas</h1>
		<p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-muted-foreground">Backend, blockchain e ingeniería de software, escritos despacio y en público.</p>
		<div class="mt-10 grid gap-6 md:grid-cols-2">
			{posts.map((post, index) => (
				<article class:list={['group border border-border bg-card transition-colors hover:border-aka/60', index === 0 && 'md:col-span-2']}>
					<a href={`/blog/${post.slug}/`} class="flex h-full flex-col">
						<div class="flex flex-1 flex-col p-6 sm:p-8">
							<p class="text-xs tracking-wider text-muted-foreground"><FormattedDate date={new Date(post.date.replaceAll('.', '-'))} /></p>
							<h2 transition:name={`blog-title-${post.slug}`} class="mt-3 text-balance font-mincho text-2xl font-semibold leading-snug tracking-tight">{post.title}</h2>
							<p class="mt-3 flex-1 text-sm leading-relaxed text-muted-foreground">{post.excerpt}</p>
							<p class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-aka">
								Leer entrada
								<Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
							</p>
						</div>
					</a>
				</article>
			))}
		</div>
	</section>
</BaseLayout>
