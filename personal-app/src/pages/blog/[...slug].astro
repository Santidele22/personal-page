---
import BlogPostLayout from '../../app/layouts/BlogPostLayout.astro';
import { fetchBlogArticle } from '../../features/blog/api/blogs';
import { renderMarkdown } from '../../shared/lib/markdown';

/* The diario entries live in the backend (issue 28), so the article renders
   on demand: new entries from the panel appear without a rebuild. Bodies are
   markdown stored server side, rendered and sanitized here before the layout
   pours them into `set:html` (issue 38: `marked` alone does not sanitize). */
const { slug } = Astro.params;

let post = null;
if (slug) {
	post = await fetchBlogArticle(slug, Astro.url.origin);
}

// Unknown slug or API outage: no content to render, answer 404.
if (!post) {
	return new Response(null, { status: 404 });
}

const html = renderMarkdown(post.content);
---

<BlogPostLayout
	title={post.title}
	description={post.description}
	pubDate={post.pubDate ?? post.createdAt}
	updatedDate={post.updatedDate}
	heroImage={null}
	html={html}
	slug={post.slug}
>
</BlogPostLayout>
