---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPostLayout from '../../app/layouts/BlogPostLayout.astro';

// The diario is built from the content collection at build time; the node
// adapter's SSR hand otherwise drops `getStaticPaths` and the route renders
// with no post under `Astro.props`.
export const prerender = true;
export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);
---

<BlogPostLayout {...post.data} slug={post.id}>
	<Content />
</BlogPostLayout>
