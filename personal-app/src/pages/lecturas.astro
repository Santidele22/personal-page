---
import BaseLayout from '../app/layouts/BaseLayout.astro';
import { SITE_NAME } from '../app/config/site';
import BookCard from '../entities/book/BookCard.astro';
import { fetchBooksPage } from '../features/book/api/books';
import EmptyState from '../shared/ui/EmptyState.astro';
import Icon from '../shared/ui/Icon.astro';
import PaginationControls from '../shared/ui/PaginationControls.astro';
import { parseOffset } from '../shared/api/pagination';

/* Dedicated, paginated archive of published books (issue 47 S9). The landing
   shelves keep their kind filter; here the full list reads top to bottom in
   one grid, both kinds together. */
const PAGE_SIZE = 8;
const offset = parseOffset(Astro.url.searchParams.get('offset'));
const serverOrigin = Astro.url.origin;
const page = await fetchBooksPage(serverOrigin, offset, PAGE_SIZE, true);
const downloadUrl = (id: number) => `${serverOrigin}/api/books/${id}/download`;

const title = `Lecturas — ${SITE_NAME}`;
const description = 'Todos los libros publicados: los que estoy leyendo, los que terminé y la reseña cuando la hay, con el PDF para descargar.';
---

<BaseLayout title={title} description={description}>
	<section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 lg:py-20" aria-labelledby="lecturas-archive-title">
		<a
			href="/#lectura"
			class="group inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-aka"
		>
			<Icon name="arrow-left" class="size-4" strokeWidth={2} />
			Volver al inicio
		</a>
		<p class="mt-6 flex items-center gap-3 text-[13px] font-medium tracking-[0.25em] text-muted-foreground">
			<Icon name="book-open" class="size-4 text-aka" />
			LECTURA
		</p>
		<h1 id="lecturas-archive-title" class="mt-3 font-mincho text-4xl font-semibold tracking-tight sm:text-5xl">Todas las lecturas</h1>
		<p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-muted-foreground">La estantería completa: desarrollo, arquitectura, testing y lo que se lee fuera del código.</p>

		{page === null && (
			<EmptyState
				icon="book-open"
				class="mt-10"
				title="No se pudieron cargar las lecturas"
				description="La API no respondió bien ahora mismo. Reintentá en unos minutos: la estantería completa vuelve enseguida."
			/>
		)}
		{page !== null && page.total === 0 && (
			<EmptyState
				icon="book-open"
				class="mt-10"
				title="Todavía no hay libros"
				description="Cuando haya títulos publicados, acá vas a ver qué estoy leyendo, la reseña y el PDF de cada uno."
			/>
		)}
		{page !== null && page.total > 0 && page.items.length === 0 && (
			<p class="mt-10 border border-border bg-card p-6 text-sm text-muted-foreground">
				No hay libros en esta página. <a href="/lecturas/" class="font-medium text-aka hover:underline">Volver a la primera página</a>.
			</p>
		)}
		{page !== null && page.items.length > 0 && (
			<>
				<div class="mt-10 grid gap-6 md:grid-cols-2">
					{page.items.map((book) => (
						<BookCard book={book} downloadUrl={downloadUrl(book.id)} headingLevel="h3" />
					))}
				</div>
				<PaginationControls basePath="/lecturas/" total={page.total} offset={page.offset} limit={PAGE_SIZE} />
			</>
		)}
	</section>
</BaseLayout>
