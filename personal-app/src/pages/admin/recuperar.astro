---
import { Font } from 'astro:assets';
import ResetPasswordForm from '../../features/auth/ResetPasswordForm';
import ThemeScript from '../../shared/ui/ThemeScript.astro';
import '../../app/styles/global.css';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex" />
		<title>Panel · Recuperar acceso — devlog</title>
		<Font cssVariable="--font-shippori" preload />
		<Font cssVariable="--font-zen" preload />
		<Font cssVariable="--font-geist-mono" />
		<ThemeScript />
	</head>
	<body class="bg-background font-sans text-foreground antialiased">
		<main class="flex min-h-dvh items-center justify-center px-4 py-12">
			<div class="w-full max-w-sm">
				<a href="/" class="flex items-center justify-center gap-2.5">
					<span class="hanko size-8 rounded-[5px] font-mono text-[10px]" aria-hidden="true">&lt;/&gt;</span>
					<span class="text-left leading-none">
						<span class="block font-mincho text-lg font-semibold tracking-tight">devlog</span>
						<span class="block text-[9px] tracking-[0.35em] text-muted-foreground">PANEL</span>
					</span>
				</a>
				<section class="mt-8 rounded-lg border border-border bg-card p-6 shadow-sm sm:p-8" aria-labelledby="reset-title">
					<p class="text-[11px] font-medium tracking-[0.2em] text-muted-foreground">PANEL · ACCESO</p>
					<h1 id="reset-title" class="mt-2 font-mincho text-2xl font-semibold tracking-tight">Recupera tu acceso</h1>
					<p class="mt-2 text-sm text-muted-foreground">
						Solicita un enlace o elige una nueva contraseña para tu cuenta de administración.
					</p>
					<ResetPasswordForm client:load />
				</section>
				<p class="mt-6 text-center text-[11px] text-muted-foreground">
					<a href="/admin/login/" class="underline decoration-border underline-offset-4 transition-colors hover:text-aka">Volver al acceso</a>
				</p>
			</div>
		</main>
	</body>
</html>
