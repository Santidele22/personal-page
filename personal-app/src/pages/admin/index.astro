---
import AdminLayout from '../../app/layouts/AdminLayout.astro';
import AdminPageHeader from '../../widgets/admin/AdminPageHeader.astro';
import AdminKpiGrid from '../../widgets/admin/AdminKpiGrid.astro';
import AdminOccupancyCard from '../../widgets/admin/AdminOccupancyCard.astro';
import AdminRenewalsCard from '../../widgets/admin/AdminRenewalsCard.astro';
import AdminTrafficCard from '../../widgets/admin/AdminTrafficCard.astro';
import Icon from '../../shared/ui/Icon.astro';
import {
	adminOwner,
	nextRenewal,
	renewals,
	renewalsNote,
	resumenKpis,
	slotOccupancy,
	slotStatusLines,
	trafficSeries,
	trafficSummary,
} from '../../entities/admin/data';

const kpiIcons: Record<string, 'eye' | 'megaphone' | 'pen-line' | 'mail'> = {
	visitas: 'eye',
	ingresos: 'megaphone',
	entradas: 'pen-line',
	suscriptores: 'mail',
};
---

<AdminLayout active="resumen" title="Panel · Resumen — devlog">
	<AdminPageHeader
		eyebrow="PANEL · RESUMEN"
		title={`Buenas, ${adminOwner.firstName}.`}
		description="El estado del diario de un vistazo: tráfico, ingresos de los slots y lo que necesita tu atención esta semana."
	>
		<button
			type="button"
			slot="action"
			class="inline-flex items-center gap-2 rounded-md bg-foreground px-5 py-3 text-sm font-medium text-background transition-colors hover:bg-aka hover:text-[#fdf8ee]"
		>
			<Icon name="pen-line" class="size-4" strokeWidth={1.75} />
			Escribir entrada
		</button>
	</AdminPageHeader>

	<AdminKpiGrid kpis={resumenKpis} icons={kpiIcons} fallbackIcon="eye" label="Indicadores del mes" />

	<section aria-label="Ocupación y renovaciones" class="grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
		<AdminOccupancyCard occupancy={slotOccupancy} lines={slotStatusLines} />
		<AdminRenewalsCard renewals={renewals} nextRenewal={nextRenewal} note={renewalsNote} />
	</section>

	<AdminTrafficCard series={trafficSeries} summary={trafficSummary} />
</AdminLayout>
