---
import AdminLayout from '../../app/layouts/AdminLayout.astro';
import AdminPageHeader from '../../widgets/admin/AdminPageHeader.astro';
import AdminMetricGrid from '../../widgets/admin/AdminMetricGrid.astro';
import AdminSlotCard from '../../widgets/admin/AdminSlotCard.astro';
import AdminDataNotice from '../../widgets/admin/AdminDataNotice.astro';
import Icon from '../../shared/ui/Icon.astro';
import type { IconName } from '../../shared/ui/Icon.astro';
import type { AdminPublicidadView } from '../../entities/admin/types';
import { loadPublicidad } from '../../features/admin/api/dashboards';
import AdvertisingPlansEditorPanel from '../../features/ad-slot/AdvertisingPlansEditorPanel';
import BrandsEditorPanel from '../../features/ad-slot/BrandsEditorPanel';

/* See the resumen page: the data is read while the server renders the page. */
const serverOrigin = Astro.url.origin;

let view: AdminPublicidadView | null = null;
let error = '';

if (serverOrigin) {
	try {
		view = await loadPublicidad(serverOrigin);
	} catch (cause) {
		error = cause instanceof Error ? cause.message : 'No se pudo cargar la publicidad.';
	}
}

const kpiIcons: Record<string, IconName> = {
	renovacion: 'calendar',
};
---

<AdminLayout active="publicidad" title="Panel · Publicidad — devlog">
	<AdminPageHeader
		eyebrow="PANEL · PUBLICIDAD"
		title="Espacios para marcas"
		description="Los planes de publicidad de la web y las marcas que los ocupan. Un solo anuncio por marca y ubicación: la calma del diario también es parte del trato."
	>
		<button
			type="button"
			slot="action"
			class="inline-flex items-center gap-2 rounded-md border border-border bg-card px-5 py-3 text-sm font-medium transition-colors hover:border-aka hover:text-aka"
		>
			<Icon name="download" class="size-4" strokeWidth={1.75} />
			Tarifa (PDF)
		</button>
	</AdminPageHeader>

	{
		error ? (
			<AdminDataNotice variant="error" title="No se pudo cargar la publicidad" message={error} />
		) : view && view.slots.length > 0 ? (
			<>
				<AdminMetricGrid kpis={view.kpis} icons={kpiIcons} label="Métricas de publicidad" />
				<section aria-label="Slots de la web" class="grid gap-6 md:grid-cols-2">
					{view.slots.map((slot) => <AdminSlotCard adSlot={slot} />)}
				</section>
			</>
		) : (
			<AdminDataNotice
				variant="empty"
				title="Sin planes de publicidad"
				message="Cuando registres planes de publicidad y sus marcas, aparecerán aquí."
			/>
		)
	}

	<section aria-labelledby="publicidad-editor" class="mt-10">
		<div class="flex flex-wrap items-baseline justify-between gap-3">
			<h2 id="publicidad-editor" class="text-[11px] font-medium tracking-[0.25em] text-muted-foreground">
				PLANES Y CARA PÚBLICA
			</h2>
			<p class="text-[11px] text-muted-foreground">
				Lo que la landing lee de cada slot: precio, descripción y las columnas públicas del plan.
			</p>
		</div>
		<div class="mt-5">
			<AdvertisingPlansEditorPanel client:load />
		</div>
	</section>

	<section aria-labelledby="publicidad-marcas" class="mt-10">
		<div class="flex flex-wrap items-baseline justify-between gap-3">
			<h2 id="publicidad-marcas" class="text-[11px] font-medium tracking-[0.25em] text-muted-foreground">
				MARCAS
			</h2>
			<p class="text-[11px] text-muted-foreground">
				Los sponsors reales que ocupan un plan: logo, enlace y vigencia.
			</p>
		</div>
		<div class="mt-5">
			<BrandsEditorPanel client:load />
		</div>
	</section>
</AdminLayout>
