---
import AdminLayout from '../../app/layouts/AdminLayout.astro';
import AdminPageHeader from '../../widgets/admin/AdminPageHeader.astro';
import AdminMetricGrid from '../../widgets/admin/AdminMetricGrid.astro';
import AdminSlotCard from '../../widgets/admin/AdminSlotCard.astro';
import Icon from '../../shared/ui/Icon.astro';
import type { IconName } from '../../shared/ui/Icon.astro';
import { adminSlots, publicidadKpis } from '../../entities/admin/data';

const kpiIcons: Record<string, IconName> = {
	renovacion: 'calendar',
};
---

<AdminLayout active="publicidad" title="Panel · Publicidad — devlog">
	<AdminPageHeader
		eyebrow="PANEL · PUBLICIDAD"
		title="Espacios para marcas"
		description="Los cuatro slots de la web, ordenados de menos a más visible. Un solo anuncio por marca y ubicación: la calma del diario también es parte del trato."
	>
		<button
			type="button"
			slot="action"
			class="inline-flex items-center gap-2 rounded-md border border-border bg-card px-5 py-3 text-sm font-medium transition-colors hover:border-aka hover:text-aka"
		>
			<Icon name="download" class="size-4" strokeWidth={1.75} />
			Tarifa (PDF)
		</button>
	</AdminPageHeader>

	<AdminMetricGrid kpis={publicidadKpis} icons={kpiIcons} label="Métricas de publicidad" />

	<section aria-label="Slots de la web" class="grid gap-6 md:grid-cols-2">
		{adminSlots.map((slot) => <AdminSlotCard adSlot={slot} />)}
	</section>
</AdminLayout>
