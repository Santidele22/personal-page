---
import FormattedDate from '../../shared/ui/FormattedDate.astro';
import Icon from '../../shared/ui/Icon.astro';
import BaseLayout from './BaseLayout.astro';

/**
 * Props of the article page. The diario reads from the backend (issue 28):
 * dates arrive as ISO strings from `GET /blogs/slug/:slug`, and the hero is
 * a plain URL (`heroImage` as an assets `ImageMetadata` object is no more; a
 * future hero column on `Blog` would serve its public URL here).
 */
type Props = {
	title: string;
	description: string;
	pubDate: string | Date;
	updatedDate?: string | Date | null;
	heroImage?: string | null;
	html: string;
	slug: string;
};

const asDate = (value: string | Date | null | undefined): Date | undefined => {
	if (!value) return undefined;
	return value instanceof Date ? value : new Date(value);
};

const { title, description, pubDate, updatedDate, heroImage, html, slug } = Astro.props;
const date = asDate(pubDate);
const updated = asDate(updatedDate);
---

<BaseLayout title={`${title} · santi.`} description={description} image={heroImage ?? undefined}>
	<article class="mx-auto max-w-4xl px-5 py-12 sm:px-8 sm:py-16">
		<a
			href="/blog/"
			class="group inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-aka"
		>
			<Icon name="arrow-left" class="size-4" strokeWidth={2} />
			Volver al archivo
		</a>
		{heroImage && (
			<img
				src={heroImage}
				alt=""
				transition:name={`blog-hero-${slug}`}
				class="mb-10 max-h-[510px] w-full border border-border object-cover shadow-[0_20px_60px_-30px_rgba(0,0,0,0.25)]"
			/>
		)}
		<header class="mx-auto mb-10 max-w-3xl border-b border-border pb-8 text-center">
			<p class="text-sm text-muted-foreground">
				{date && <FormattedDate date={date} />}
				{updated && <span class="mt-1 block text-xs italic">Actualizado el <FormattedDate date={updated} /></span>}
			</p>
			<h1 transition:name={`blog-title-${slug}`} class="mt-4 text-balance font-mincho text-3xl font-semibold tracking-tight sm:text-5xl">{title}</h1>
			<p class="mx-auto mt-4 max-w-2xl text-muted-foreground">{description}</p>
		</header>
		{/* The backend stores the markdown body; `renderMarkdown`
		    (`src/shared/lib/markdown.ts`) renders it with `marked` and sanitizes
		    the HTML on the server before this `set:html`: no scripts, no `on*`
		    handlers, and only http/https/mailto link schemes survive. */}
		<div class="article-content mx-auto max-w-3xl text-[15px] leading-relaxed text-foreground/90 sm:text-base" set:html={html} />
	</article>
</BaseLayout>

<style>
	.article-content :global(h2),
	.article-content :global(h3),
	.article-content :global(h4) {
		margin: 2em 0 0.65em;
		font-family: var(--font-shippori), serif;
		font-weight: 600;
		line-height: 1.25;
		color: var(--foreground);
	}

	.article-content :global(h2) { font-size: 1.75rem; }
	.article-content :global(h3) { font-size: 1.4rem; }
	.article-content :global(p),
	.article-content :global(ul),
	.article-content :global(ol),
	.article-content :global(blockquote),
	.article-content :global(pre) { margin: 0 0 1.35em; }
	.article-content :global(ul),
	.article-content :global(ol) { padding-left: 1.5em; }
	.article-content :global(ul) { list-style: disc; }
	.article-content :global(ol) { list-style: decimal; }
	.article-content :global(a) { color: var(--aka); text-decoration: underline; text-underline-offset: 3px; }
	.article-content :global(blockquote) { border-left: 3px solid var(--aka); padding-left: 1.25em; color: var(--muted-foreground); font-style: italic; }
	.article-content :global(code) { border: 1px solid var(--border); border-radius: 0.25rem; background: var(--secondary); padding: 0.1em 0.35em; font-family: var(--font-geist-mono), monospace; font-size: 0.9em; }
	.article-content :global(pre) { overflow-x: auto; border: 1px solid var(--border); background: var(--card); padding: 1.25em; }
	.article-content :global(pre code) { border: 0; background: transparent; padding: 0; }
	.article-content :global(img) { height: auto; max-width: 100%; border: 1px solid var(--border); }
</style>
