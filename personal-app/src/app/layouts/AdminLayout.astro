---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import AdminSidebar from '../../widgets/admin/AdminSidebar.astro';
import AdminTopBar from '../../widgets/admin/AdminTopBar.astro';
import type { AdminSection } from '../../entities/admin/types';
import '../styles/global.css';

interface Props {
	active: AdminSection;
	title: string;
}

const { active, title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex" />
		<title>{title}</title>
		<Font cssVariable="--font-shippori" preload />
		<Font cssVariable="--font-zen" preload />
		<Font cssVariable="--font-geist-mono" />
		<ClientRouter />
		<script is:inline>
			(() => {
				const applyTheme = (root) => {
					try {
						const saved = localStorage.getItem('santi-theme');
						const dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
						root.classList.toggle('dark', dark);
						root.style.colorScheme = dark ? 'dark' : 'light';
					} catch {
						root.classList.remove('dark');
						root.style.colorScheme = 'light';
					}
				};

				if (!window.__santiThemeHandler) {
					document.addEventListener('astro:before-swap', (event) => {
						applyTheme(event.newDocument.documentElement);
					});
					window.__santiThemeHandler = true;
				}

				applyTheme(document.documentElement);
			})();
		</script>
	</head>
	<body class="bg-background font-sans text-foreground antialiased">
		<div class="flex min-h-dvh flex-col lg:flex-row">
			<AdminSidebar active={active} />
			<div class="flex min-w-0 flex-1 flex-col">
				<AdminTopBar />
				<main class="flex-1 px-4 py-10 sm:px-8 lg:px-12 lg:py-12">
					<div class="mx-auto flex max-w-6xl flex-col gap-8">
						<slot />
					</div>
				</main>
			</div>
		</div>
	</body>
</html>
