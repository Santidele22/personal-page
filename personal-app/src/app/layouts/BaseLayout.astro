---
import { Font } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../../assets/blog-placeholder-1.jpg';
import { fetchProfile } from '../../features/profile/api/profile';
import SiteFooter from '../../widgets/site-footer/SiteFooter.astro';
import SiteHeader from '../../widgets/site-header/SiteHeader.astro';
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_NAME, SITE_TITLE } from '../config/site';
import PageLoader from '../../shared/ui/PageLoader.astro';
import ThemeScript from '../../shared/ui/ThemeScript.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	/** `ImageMetadata` from `astro:assets` or a plain URL string (backend heroes). */
	image?: ImageMetadata | string;
}

/* Site meta comes from the profile while the API answers; the `site.ts`
   constants remain the offline fallback. A page-level `title`/`description`
   still wins, exactly as when the constants were the only source. */
const serverOrigin = Astro.url.origin;
const profile = await fetchProfile(serverOrigin);
const siteName = profile?.siteName || SITE_NAME;
const siteTitle = profile?.siteTitle || SITE_TITLE;
const siteDescription = profile?.siteDescription || SITE_DESCRIPTION;
const siteAuthor = profile?.siteAuthor || SITE_AUTHOR;

const { title = siteTitle, description = siteDescription, image = FallbackImage } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="application/rss+xml" title={siteName} href={new URL('rss.xml', Astro.site)} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="author" content={siteAuthor} />
		<meta name="keywords" content="Santiago Delebecq, blog de desarrollo, backend, blockchain, ingeniería de software, programación, aprender en público" />
		<link rel="canonical" href={canonicalURL} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:image" content={typeof image === 'string' ? new URL(image, Astro.url).toString() : new URL(image.src, Astro.url)} />
		<meta name="twitter:card" content="summary_large_image" />
		<title>{title}</title>
		<Font cssVariable="--font-shippori" preload />
		<Font cssVariable="--font-zen" preload />
		<Font cssVariable="--font-geist-mono" />
		<ThemeScript />
	</head>
	<body class="bg-background font-sans text-foreground antialiased">
		<PageLoader siteName={siteName} />
		<div class="flex min-h-dvh flex-col">
			<SiteHeader siteName={siteName} />
			<main class="flex-1">
				<slot />
			</main>
			<SiteFooter />
		</div>
	</body>
</html>
