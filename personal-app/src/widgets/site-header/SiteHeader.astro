---
import MobileNavigation from '../../features/mobile-navigation/MobileNavigation';
import ThemeToggle from '../../features/theme-toggle/ThemeToggle';
import { fetchMenuLinks, navLinksFallback } from '../../features/menu/api/menu-links';

interface Props {
	/** Brand wordmark handed down by the layout (profile-driven), e.g. `devlog.`. */
	siteName?: string;
}

/* The menu links are read while the server renders the page; the fallback
   below is the list this header shipped with before the menu-items entity
   existed. The layout already fetched the profile for the document head, so
   the wordmark arrives as a prop instead of a second backend read. */
const { siteName } = Astro.props;
const serverOrigin = Astro.url.origin;
const wordmark = siteName ? siteName.replace(/\.$/, '') : null;
const wordmarkPeriod = Boolean(siteName?.endsWith('.'));
const navLinks = (await fetchMenuLinks(serverOrigin)) ?? navLinksFallback;
---

<header class="sticky top-0 z-50 border-b border-border bg-background/85 backdrop-blur-md">
	<div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
		<a href="/" class="group flex items-center gap-3" aria-label={`${wordmark ?? 'Inicio'} — inicio`}>
			<span class="hanko size-8 shrink-0 rounded-[4px] font-mono text-[11px] font-semibold leading-none transition-transform group-hover:-rotate-6">&lt;/&gt;</span>
			{wordmark && (
				<span class="flex items-baseline gap-2.5">
					<span class="font-mincho text-lg font-semibold tracking-tight">{wordmark}{wordmarkPeriod && <span class="text-aka">.</span>}</span>
					<span class="hidden text-[10px] font-medium tracking-[0.25em] text-muted-foreground sm:inline">BLOG DE DESARROLLO</span>
				</span>
			)}
		</a>
		<nav aria-label="Principal" class="hidden items-center gap-7 md:flex">
			{navLinks.map((link) => <a href={link.href} class="text-sm text-muted-foreground transition-colors hover:text-aka">{link.label}</a>)}
		</nav>
		<div class="flex items-center gap-2">
			<ThemeToggle client:load />
			<a href="/#contacto" class="hidden rounded-md border border-foreground/20 px-4 py-2 text-sm font-medium transition-colors hover:border-aka hover:bg-aka hover:text-[#fdf8ee] md:inline-flex">Escribime</a>
			<MobileNavigation links={navLinks} client:media="(max-width: 767px)" />
		</div>
	</div>
</header>
