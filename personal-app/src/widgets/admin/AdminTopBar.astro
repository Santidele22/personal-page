---
import Icon from '../../shared/ui/Icon.astro';
import ThemeToggle from '../../features/theme-toggle/ThemeToggle';
import SessionGuard from '../../features/auth/SessionGuard';
import TopBarStatus from '../../features/auth/TopBarStatus';
import UserBadge from '../../features/auth/UserBadge';

---

<header class="flex items-center gap-4 border-b border-border bg-card/80 px-4 py-3 backdrop-blur-sm sm:px-8">
	{/*
		The top bar is the one shell element every admin page renders, so it also
		hosts the session gate island: `SessionGuard` redirects anonymous visitors
		and loads the session the status and the avatar read below.
	*/}
	<SessionGuard client:load />
	<TopBarStatus client:idle />
	<div class="ml-auto flex items-center gap-3">
		<a
			href="/"
			class="inline-flex items-center gap-2 rounded-md border border-border bg-card px-3 py-2 text-sm font-medium transition-colors hover:border-aka hover:text-aka"
		>
			<Icon name="external-link" class="size-4" strokeWidth={1.75} />
			<span class="hidden sm:inline">Ver web</span>
		</a>
		<ThemeToggle client:idle />
		<UserBadge client:idle />
	</div>
</header>
