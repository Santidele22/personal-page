---
import Icon from '../../shared/ui/Icon.astro';
import type { AdminPost } from '../../entities/admin/types';

interface Props {
	posts: AdminPost[];
}

const { posts } = Astro.props;

const statusLabel = {
	publicado: 'Publicado',
	borrador: 'Borrador',
} satisfies Record<AdminPost['status'], string>;

const headBase = 'py-4 text-[11px] font-medium tracking-[0.2em] text-muted-foreground';
const cellBase = 'py-4';

const columns = [
	{ label: 'ENTRADA', class: `${headBase} px-6` },
	{ label: 'ESTADO', class: `${headBase} px-4` },
	{ label: 'VISITAS', class: `${headBase} px-4` },
	{ label: 'COMENTARIOS', class: `${headBase} px-4` },
	{ label: 'FECHA', class: `${headBase} px-4` },
	{ label: 'ACCIONES', class: `${headBase} px-6 text-right` },
] as const;
---

<section aria-label="Tabla de entradas" class="overflow-hidden border border-border bg-card">
	<div class="overflow-x-auto">
		<table class="w-full min-w-[760px] text-left text-sm">
			<caption class="sr-only">Entradas del diario con estado, visitas, comentarios y fecha</caption>
			<thead>
				<tr class="border-b border-border">
					{columns.map((column) => <th scope="col" class={column.class}>{column.label}</th>)}
				</tr>
			</thead>
			<tbody class="divide-y divide-border">
				{
					posts.map((post) => (
						<tr class="group transition-colors hover:bg-secondary/50">
							<th scope="row" class={`${cellBase} max-w-sm px-6 font-sans font-normal`}>
								<span class="block truncate font-medium">{post.title}</span>
								<span class="mt-0.5 block font-mono text-[10px] tracking-[0.2em] text-muted-foreground">{post.category}</span>
							</th>
							<td class={`${cellBase} whitespace-nowrap px-4`}>
								<span class="flex items-center gap-2">
									<span
										class:list={['size-1.5 rounded-full', post.status === 'publicado' ? 'bg-foreground/70' : 'border border-muted-foreground']}
										aria-hidden="true"
									/>
									{statusLabel[post.status]}
								</span>
							</td>
							<td class={`${cellBase} whitespace-nowrap px-4 font-mono text-[13px]`}>{post.views ?? '—'}</td>
							<td class={`${cellBase} whitespace-nowrap px-4`}>
								<span class="inline-flex items-center gap-1.5 text-muted-foreground">
									<Icon name="message-square" class="size-3.5" strokeWidth={1.75} />
									{post.comments ?? '—'}
								</span>
							</td>
							<td class={`${cellBase} whitespace-nowrap px-4 font-mono text-[13px] text-muted-foreground`}>{post.date}</td>
							<td class={`${cellBase} px-6 text-right`}>
								<span class="inline-flex items-center gap-3 text-muted-foreground opacity-60 transition-opacity group-hover:opacity-100">
									<a href="#" aria-label={`Ver ${post.title}`} class="transition-colors hover:text-aka">
										<Icon name="eye" class="size-4" strokeWidth={1.5} />
									</a>
									<a href="#" aria-label={`Editar ${post.title}`} class="transition-colors hover:text-aka">
										<Icon name="pen-line" class="size-4" strokeWidth={1.5} />
									</a>
								</span>
							</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
</section>
