---
import Icon from '../../shared/ui/Icon.astro';
import type { AdminPost } from '../../entities/admin/types';

interface Props {
	posts: AdminPost[];
}

const { posts } = Astro.props;

const statusLabel = {
	publicado: 'Publicado',
	borrador: 'Borrador',
} satisfies Record<AdminPost['status'], string>;

const headBase = 'py-4 text-[11px] font-medium tracking-[0.2em] text-muted-foreground';
const cellBase = 'py-4';

/*
 * Acciones de fila: la misma base para las dos, con la vida que aporta el hover
 * y el foco visible. El movimiento (lift + color + pill) solo se activa bajo
 * `motion-safe`, así el `prefers-reduced-motion` lo degrada sin empujar la fila.
 */
const actionBase =
	'inline-flex size-8 items-center justify-center rounded-md text-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring motion-safe:transition-[translate,color,background-color] motion-safe:duration-150';
const actionLive = `${actionBase} hover:bg-secondary hover:text-aka motion-safe:hover:-translate-y-0.5`;
/** Misma base, pero apagada y no interactiva cuando la acción no tiene destino. */
const actionMuted = `${actionBase} pointer-events-none opacity-40`;
/** El borrado pide su rojo: hover destructive para que no se lea como edición. */
const actionDanger = `${actionBase} hover:bg-destructive/15 hover:text-destructive motion-safe:hover:-translate-y-0.5`;

const columns = [
	{ label: 'ENTRADA', class: `${headBase} px-6` },
	{ label: 'ESTADO', class: `${headBase} px-4` },
	{ label: 'VISITAS', class: `${headBase} px-4` },
	{ label: 'COMENTARIOS', class: `${headBase} px-4` },
	{ label: 'FECHA', class: `${headBase} px-4` },
	{ label: 'ACCIONES', class: `${headBase} px-6 text-right` },
] as const;
---

<section aria-label="Tabla de entradas" class="overflow-hidden border border-border bg-card">
	<div class="overflow-x-auto">
		<table class="w-full min-w-[760px] text-left text-sm">
			<caption class="sr-only">Entradas del diario con estado, visitas, comentarios y fecha</caption>
			<thead>
				<tr class="border-b border-border">
					{columns.map((column) => <th scope="col" class={column.class}>{column.label}</th>)}
				</tr>
			</thead>
			<tbody class="divide-y divide-border">
				{
					posts.map((post) => (
						<tr class="group transition-colors hover:bg-secondary/50">
							<th scope="row" class={`${cellBase} max-w-sm px-6 font-sans font-normal`}>
								<span class="block truncate font-medium">{post.title}</span>
								<span class="mt-0.5 block font-mono text-[10px] tracking-[0.2em] text-muted-foreground">{post.category}</span>
							</th>
							<td class={`${cellBase} whitespace-nowrap px-4`}>
								<span class="flex items-center gap-2">
									<span
										class:list={['size-1.5 rounded-full', post.status === 'publicado' ? 'bg-foreground/70' : 'border border-muted-foreground']}
										aria-hidden="true"
									/>
									{statusLabel[post.status]}
								</span>
							</td>
							<td class={`${cellBase} whitespace-nowrap px-4 font-mono text-[13px]`}>{post.views ?? '—'}</td>
							<td class={`${cellBase} whitespace-nowrap px-4`}>
								<span class="inline-flex items-center gap-1.5 text-muted-foreground">
									<Icon name="message-square" class="size-3.5" strokeWidth={1.75} />
									{post.comments ?? '—'}
								</span>
							</td>
							<td class={`${cellBase} whitespace-nowrap px-4 font-mono text-[13px] text-muted-foreground`}>{post.date}</td>
							<td class={`${cellBase} px-6 text-right`}>
								<span class="inline-flex items-center gap-1">
									{
										post.slug ? (
											<a href={`/blog/${post.slug}/`} aria-label={`Ver ${post.title}`} class={actionLive}>
												<Icon name="eye" class="size-4" strokeWidth={1.5} />
											</a>
										) : (
											<button
												type="button"
												disabled
												aria-label={`Ver ${post.title} — todavía sin enlace público`}
												class={actionMuted}
											>
												<Icon name="eye" class="size-4" strokeWidth={1.5} />
											</button>
										)
									}
									<button type="button" data-editor-id={post.id} aria-label={`Editar ${post.title}`} class={actionLive}>
										<Icon name="pen-line" class="size-4" strokeWidth={1.5} />
									</button>
									<button
										type="button"
										data-delete-id={post.id}
										data-delete-title={post.title}
										aria-label={`Eliminar ${post.title}`}
										class={actionDanger}
									>
										<Icon name="trash-2" class="size-4" strokeWidth={1.5} />
									</button>
								</span>
							</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
</section>

<script>
	/*
	 * «Editar» puente: la tabla se renderiza en servidor y el modal vive en la
	 * isla Solid `DiarioEditorPanel`. En vez de importar la isla desde acá, el
	 * botón delega en un evento de documento que la isla escucha y abre el modal
	 * igual que con su propio botón «+ Nueva entrada».
	 *
	 * «Eliminar» sigue el mismo puente: la isla abre el diálogo de confirmación,
	 * así que esta tabla nunca llama a la API ni decide el borrado por sí sola.
	 */
	const OPEN_EDITOR_EVENT = 'diario:open-editor';
	const REQUEST_DELETE_EVENT = 'diario:request-delete';

	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Element)) return;

		const editTrigger = event.target.closest('[data-editor-id]');
		const editId = editTrigger?.getAttribute('data-editor-id');
		if (editId) {
			document.dispatchEvent(new CustomEvent(OPEN_EDITOR_EVENT, { detail: { id: editId } }));
			return;
		}

		const deleteTrigger = event.target.closest('[data-delete-id]');
		const deleteId = deleteTrigger?.getAttribute('data-delete-id');
		if (deleteId) {
			document.dispatchEvent(
				new CustomEvent(REQUEST_DELETE_EVENT, {
					detail: { id: deleteId, title: deleteTrigger?.getAttribute('data-delete-title') ?? '' },
				}),
			);
		}
	});
</script>
