---
import Icon from '../../shared/ui/Icon.astro';
import type { AdminSlot } from '../../entities/admin/types';

interface Props {
	adSlot: AdminSlot;
}

const { adSlot: slot } = Astro.props;
const reservado = slot.status === 'reservado';
---

<article
	class:list={[
		'flex flex-col border bg-card p-6',
		reservado ? 'border-border' : 'border-dashed border-aka/50 bg-aka/[0.04]',
	]}
>
	<div class="flex items-start justify-between gap-3">
		<div>
			<h3 class="font-mincho text-2xl font-semibold tracking-tight">{slot.name}</h3>
			<p class="mt-1.5 text-[11px] tracking-wider text-muted-foreground">
				<span class="font-mono">{slot.dimensions}</span> · {slot.position}
			</p>
		</div>
		{
			reservado ? (
				<span class="flex shrink-0 items-center gap-1.5 rounded-sm bg-aka px-2.5 py-1 text-[10px] font-medium tracking-[0.15em] text-[#fdf8ee]">
					<span class="size-1.5 rounded-full bg-[#fdf8ee]" aria-hidden="true" />
					RESERVADO
				</span>
			) : (
				<span class="inline-flex shrink-0 items-center gap-1.5 rounded-sm border border-aka px-2.5 py-1 text-[10px] font-medium tracking-[0.15em] text-aka">
					<span class="size-1.5 rounded-full border border-aka" aria-hidden="true" />
					DISPONIBLE
				</span>
			)
		}
	</div>

	<hr class="my-5 border-border" />

	<div class="flex items-start justify-between gap-6">
		{
			reservado && slot.brand ? (
				<div>
					<p class="text-sm font-medium">{slot.brand}</p>
					<p class="mt-1 font-mono text-[11px] text-muted-foreground">{slot.period}</p>
					<p class="mt-1 font-mono text-[11px] text-muted-foreground">{slot.impressions}</p>
				</div>
			) : (
				<div>
					<p class="text-sm text-muted-foreground">Sin marca asignada</p>
					<p class="mt-1 font-mono text-[11px] text-muted-foreground">{slot.impressions}</p>
				</div>
			)
		}
		<p class="shrink-0 text-right">
			<span class="block font-mincho text-3xl font-semibold tracking-tight">{slot.price}</span>
			<span class="mt-1 block text-[10px] tracking-[0.25em] text-muted-foreground">MENSUAL</span>
		</p>
	</div>

	<div class="mt-5 flex items-center gap-4">
		{
			reservado ? (
				<>
					<button
						type="button"
						class="inline-flex flex-1 items-center justify-center gap-2 rounded-md border border-border bg-card px-4 py-2.5 text-sm font-medium transition-colors hover:border-aka hover:text-aka"
					>
						<Icon name="calendar" class="size-4" strokeWidth={1.75} />
						Gestionar renovación
					</button>
					<a href="#" class="text-sm text-muted-foreground transition-colors hover:text-aka">Ver contrato</a>
				</>
			) : (
				<button
					type="button"
					class="inline-flex flex-1 items-center justify-center gap-2 rounded-md bg-aka px-4 py-2.5 text-sm font-medium text-[#fdf8ee] transition-colors hover:bg-aka-deep"
				>
					<Icon name="megaphone" class="size-4" strokeWidth={1.75} />
					Reservar para una marca
				</button>
			)
		}
	</div>
</article>
