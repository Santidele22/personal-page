---
interface Props {
	eyebrow: string;
	title: string;
	description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="lg:flex lg:items-start lg:justify-between lg:gap-8">
	<div>
		<p class="text-[11px] font-medium tracking-[0.3em] text-muted-foreground">{eyebrow}</p>
		<h1 class="mt-3 text-balance font-mincho text-4xl font-semibold leading-tight tracking-tight sm:text-[2.75rem]">{title}</h1>
		<p class="mt-4 max-w-xl text-sm leading-relaxed text-muted-foreground sm:text-[15px]">{description}</p>
	</div>
	<div class="mt-6 shrink-0 lg:mt-1 lg:ml-6">
		<slot name="action" />
	</div>
</div>
