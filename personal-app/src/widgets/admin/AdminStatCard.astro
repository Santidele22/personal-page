---
import Icon from '../../shared/ui/Icon.astro';
import type { AdminKpi } from '../../entities/admin/types';
import type { IconName } from '../../shared/ui/Icon.astro';

interface Props {
	kpi: AdminKpi;
	/** Nombre del icono decorativo de la esquina superior derecha. */
	icon: IconName;
}

const { kpi, icon } = Astro.props;
---

<article class="border border-border bg-card p-5 sm:p-6">
	<div class="flex items-start justify-between gap-3">
		<p class="pt-1 text-[11px] font-medium tracking-[0.2em] text-muted-foreground">{kpi.label}</p>
		<span aria-hidden="true" class="grid size-9 shrink-0 place-items-center rounded-md border border-aka/30 bg-aka/5 text-aka">
			<Icon name={icon} class="size-4" strokeWidth={1.75} />
		</span>
	</div>
	<p class="mt-4 font-mincho text-3xl font-semibold tracking-tight sm:text-4xl">
		{kpi.value}{kpi.unit && <span class="font-sans text-sm font-normal text-muted-foreground"> {kpi.unit}</span>}
	</p>
	{
		kpi.trend && (
			<p class="mt-2.5 flex items-center gap-1.5 text-xs font-medium text-aka">
				<Icon name="trending-up" class="size-3.5" strokeWidth={2} />
				{kpi.trend}
			</p>
		)
	}
	{kpi.note && <p class="mt-2 text-xs text-muted-foreground">{kpi.note}</p>}
</article>
