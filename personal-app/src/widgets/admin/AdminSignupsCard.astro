---
import AdminSignupsChart from './AdminSignupsChart.tsx';
import type { AdminSignupByMonth } from '../../entities/admin/types';

interface Props {
	data: AdminSignupByMonth[];
	/** Resumen del periodo para la cabecera, ya formateado. */
	summary: string;
}

const { data, summary } = Astro.props;
---

<section aria-label="Altas por mes" class="border border-border bg-card p-6">
	<header class="flex items-baseline justify-between gap-4">
		<h2 class="text-[11px] font-medium tracking-[0.25em] text-muted-foreground">ALTAS POR MES — ÚLTIMOS 8 MESES</h2>
		<p class="font-mono text-[11px] text-muted-foreground">{summary}</p>
	</header>
	<div class="mt-8">
		<AdminSignupsChart data={data} client:visible />
	</div>
</section>
