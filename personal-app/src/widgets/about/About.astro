---
import { hasAdminSession } from '../../features/auth/api/serverSession';
import { fetchProfile } from '../../features/profile/api/profile';
import Icon from '../../shared/ui/Icon.astro';
import Reveal from '../../shared/ui/Reveal.astro';
import { buildAboutFolios } from './aboutSection';
import WorkshopBenchArt from './WorkshopBenchArt.astro';

/* The profile is read while the server renders the page. A failed read leaves
   the copy empty: the backend is the single source of truth and the section
   never shows shipped text (projects-type-restore L3). */
const serverOrigin = Astro.url.origin;
const [profile, isAdmin] = await Promise.all([
	fetchProfile(serverOrigin),
	hasAdminSession(Astro.request.headers.get('cookie')),
]);

const name = (profile?.name ?? '').replace(/\.$/, '');
const firstName = name.trim().split(/\s+/)[0] || name;

const folios = buildAboutFolios(profile?.bioParagraphs ?? []);
---

<section id="quien-soy" class="scroll-mt-20 border-y border-border bg-secondary/40" aria-labelledby="quien-soy-title">
	<div class="mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 lg:grid-cols-[minmax(280px,420px)_1fr] lg:items-center lg:gap-16 lg:py-24">
		<Reveal class="relative mx-auto w-full max-w-sm lg:max-w-none">
			<figure class="relative border border-border bg-card shadow-[0_20px_60px_-30px_rgba(0,0,0,0.25)]">
				<span aria-hidden="true" class="absolute -left-px -top-px z-[3] size-9 border-b border-r border-aka"></span>
				<WorkshopBenchArt isAdmin={isAdmin} />
				<figcaption class="flex items-center justify-between gap-2 border-t border-border px-4 py-3 text-[11px] tracking-[0.06em] text-muted-foreground">
					<span>taller casero — código de pie, electrónica a mano</span>
					<span id="workshopCaptionState" class="font-mono text-[10px] uppercase tracking-[0.14em] text-aka">SANTI · CODEANDO EN PC</span>
				</figcaption>
			</figure>
		</Reveal>
		<div>
			<Reveal>
				<p class="flex items-center gap-3 text-[13px] font-medium tracking-[0.25em] text-muted-foreground">
					<Icon name="user" class="size-4 text-aka" />
					EL COPISTA
				</p>
			</Reveal>
			<Reveal delay={0.08}>
				<h2 id="quien-soy-title" class="mt-3 font-mincho text-3xl font-semibold tracking-tight sm:text-4xl">{name ? `Hola, soy ${name}` : 'El copista'}<span class="text-aka">.</span></h2>
			</Reveal>
			{folios.length > 0 && (
				<Reveal delay={0.14}>
					<div class="mt-7 flex max-w-[36rem] flex-col gap-[1.4rem] border-l border-border pl-6 text-[15px] leading-[1.65] text-muted-foreground">
						{folios.map((folio) => (
							<div class="relative before:absolute before:-left-6 before:top-[0.45rem] before:h-px before:w-[7px] before:bg-aka before:content-['']">
								<span class="block font-mono text-[10.5px] uppercase tracking-[0.2em] text-aka">{folio.tag}</span>
								<p class="mt-[0.3rem] text-[15px] leading-[1.7] text-muted-foreground">
									{folio.segments.map((segment) =>
										segment.strong ? <strong class="font-medium text-foreground">{segment.text}</strong> : segment.text,
									)}
								</p>
							</div>
						))}
					</div>
				</Reveal>
			)}
			{name && (
				<Reveal delay={0.2}>
					<p class="mt-9 flex max-w-[36rem] items-center gap-4 border-t border-border pt-6 font-mincho text-xl italic text-foreground/80">
						— {firstName}
						<span class="hanko size-8 rounded-[4px] font-mono text-[10px] font-semibold not-italic">&lt;/&gt;</span>
					</p>
				</Reveal>
			)}
		</div>
	</div>
</section>
