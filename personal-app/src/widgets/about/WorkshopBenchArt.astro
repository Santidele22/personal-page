<style>
	.art-stage {
		position: relative;
		width: 100%;
		aspect-ratio: 4 / 5;
		cursor: pointer;
		user-select: none;
		overflow: hidden;
		background:
			radial-gradient(circle at 68% 22%, color-mix(in srgb, var(--aka) 12%, transparent) 0%, transparent 50%),
			radial-gradient(circle at 48% 62%, color-mix(in srgb, var(--foreground) 5%, transparent) 0%, transparent 64%);
	}

	.art-stage:focus-visible {
		outline: 2px solid var(--aka);
		outline-offset: -2px;
	}

	.stage-controls {
		position: absolute;
		left: 0.85rem;
		right: 0.85rem;
		bottom: 0.85rem;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		pointer-events: none;
	}

	.stage-btn {
		pointer-events: auto;
		border: 1px solid var(--border);
		background: color-mix(in srgb, var(--card) 88%, transparent);
		backdrop-filter: blur(6px);
		padding: 0.35rem 0.65rem;
		border-radius: 3px;
		font-size: 10px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted-foreground);
		cursor: pointer;
		transition: border-color 150ms ease, color 150ms ease, background-color 150ms ease;
	}

	.stage-btn:hover {
		border-color: var(--aka);
		color: var(--aka);
	}

	.stage-btn.is-assembled {
		border-color: var(--aka);
		background: var(--aka);
		color: #fdf8ee;
	}

	.stage-seal {
		width: 2rem;
		height: 2rem;
		border-radius: 4px;
		font-size: 10px;
		font-weight: 600;
	}

	.scene {
		--iso-top: #d9cfbb;
		--iso-left: #c2b69e;
		--iso-right: #a99c83;
		--iso-edge: rgba(35, 32, 26, 0.55);
		--iso-dark: #8d8069;
		--sky-top: #cfc8bb;
		--sky-bottom: #e8e1d2;
		--city: #9d958a;
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}

	:global(.dark) .scene {
		--iso-top: #8e877c;
		--iso-left: #6f695f;
		--iso-right: #57524a;
		--iso-edge: rgba(234, 227, 211, 0.55);
		--iso-dark: #3a352e;
		--sky-top: #2f2b27;
		--sky-bottom: #4a443d;
		--city: #1e1b17;
	}

	.scene .ft { fill: var(--iso-top); }
	.scene .fl { fill: var(--iso-left); }
	.scene .fr { fill: var(--iso-right); }
	.scene .bx polygon,
	.scene .edge {
		stroke: var(--iso-edge);
		stroke-width: 0.7;
		stroke-linejoin: round;
	}
	.scene .bx.dark .ft { fill: var(--iso-left); }
	.scene .bx.dark .fl { fill: var(--iso-right); }
	.scene .bx.dark .fr { fill: var(--iso-dark); }
	.scene .bx.iron .ft { fill: var(--iso-right); }
	.scene .bx.iron .fl { fill: var(--iso-dark); }
	.scene .bx.iron .fr { fill: color-mix(in srgb, var(--iso-dark) 70%, #000); }
	.scene .e {
		stroke: var(--iso-edge);
		stroke-width: 0.8;
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.scene .e2 {
		stroke: var(--iso-edge);
		stroke-width: 1.6;
		fill: none;
		stroke-linecap: round;
	}
	.scene .thin {
		stroke: var(--iso-edge);
		stroke-width: 0.5;
		fill: none;
		vector-effect: non-scaling-stroke;
	}
	.scene .ink { fill: var(--iso-edge); }
	.scene .fillTop { fill: var(--iso-top); }
	.scene .fillLeft { fill: var(--iso-left); }
	.scene .fillRight { fill: var(--iso-right); }
	.scene .fillDark { fill: var(--iso-dark); }
	.scene .aka {
		stroke: var(--aka);
		fill: none;
		stroke-width: 1.1;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.scene .akaFill { fill: var(--aka); }
	.scene .ns { vector-effect: non-scaling-stroke; }
	.scene .city { fill: var(--city); }
	.scene .card { fill: var(--card); }

	.scene .seam {
		stroke-dasharray: 220;
		stroke-dashoffset: 220;
		transition: stroke-dashoffset 1.6s ease;
	}
	.art-stage.is-on .scene .seam { stroke-dashoffset: 0; }
	.scene .seam-ghost {
		stroke: var(--aka);
		opacity: 0.28;
		fill: none;
		stroke-width: 0.9;
	}

	@keyframes blink {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.15; }
	}
	@keyframes bob {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-2.5px); }
	}
	@keyframes spark {
		0% { opacity: 1; transform: translate(0, 0) scale(1); }
		100% { opacity: 0; transform: translate(var(--sx), var(--sy)) scale(0.3); }
	}
	@keyframes flow {
		to { stroke-dashoffset: -24; }
	}
	@keyframes workshop-cart-move {
		0% { transform: translate(0, 0); opacity: 0; }
		8% { opacity: 1; }
		85% { opacity: 1; }
		100% { transform: translate(-187.1px, -108px); opacity: 0; }
	}

	.scene .blink { animation: blink 1.4s steps(2) infinite; }
	.scene .bob {
		animation: bob 2.6s ease-in-out infinite;
		transform-box: fill-box;
	}
	.scene .spark {
		transform-box: fill-box;
		transform-origin: center;
		animation: spark 0.9s ease-out infinite;
		opacity: 0;
	}
	.scene .sparks {
		opacity: 0.35;
		transition: opacity 0.4s ease;
	}
	.art-stage.is-on .scene .sparks { opacity: 1; }
	.scene .glow {
		opacity: 0.45;
		transition: opacity 0.6s ease;
	}
	.art-stage.is-on .scene .glow { opacity: 1; }
	.scene .lit {
		opacity: 0.25;
		transition: opacity 0.5s ease;
	}
	.art-stage.is-on .scene .lit { opacity: 1; }
	.scene .flow { stroke-dasharray: 3 9; }
	.art-stage.is-on .scene .flow { animation: flow 1s linear infinite; }
	.scene .term-on { display: none; }
	.art-stage.is-on .scene .term-on { display: inline; }
	.art-stage.is-on .scene .term-off { display: none; }
	.scene .term {
		font-family: var(--font-geist-mono);
		font-size: 4.4px;
		fill: var(--muted-foreground);
		letter-spacing: 0.02em;
	}
	.scene .term.akaTxt { fill: var(--aka); }
	.scene .cart { animation: workshop-cart-move 11s linear infinite; }

	@media (prefers-reduced-motion: reduce) {
		.scene .cart,
		.scene .blink,
		.scene .bob,
		.scene .spark,
		.scene .flow {
