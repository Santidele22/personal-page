---
// Isometric home electronics & standing Linux PC workshop driven by a live FSM.

interface Props {
	isAdmin?: boolean;
}

const { isAdmin = false } = Astro.props;
---

<div
	id="workshopStage"
	class="art-stage"
	data-visitor={isAdmin ? 'admin' : 'guest'}
	role="region"
	aria-label="Taller isométrico interactivo: Santiago construye una consola Linux casera en Rust entre su standing desk y el banco de electrónica junto a un dron soldador y una araña cargadora."
>
	<canvas id="workshopCanvas" class="workshop-canvas" aria-hidden="true"></canvas>

	<div class="workshop-bubble font-mono" id="workshopDialogue" aria-live="polite" hidden>
		<span class="bubble-speaker" id="workshopSpeaker"></span>
		<span class="bubble-text" id="workshopLine"></span>
	</div>

	<div class="stage-controls">
		<div class="stage-btn-group">
			<button type="button" id="workshopStationBtn" class="stage-btn font-mono" aria-pressed="false">
				Ir al banco
			</button>
			<button
				type="button"
				id="workshopFailBtn"
				class="stage-btn stage-btn-ghost font-mono"
				aria-pressed="false"
				title="Simular fallo y estado de pánico"
			>
				Fallo
			</button>
			<button
				type="button"
				id="workshopFsmBtn"
				class="stage-btn stage-btn-ghost font-mono"
				aria-pressed="false"
				title="Mostrar máquina de estados en vivo"
			>
				FSM
			</button>
		</div>
		<span class="hanko stage-seal font-mono" aria-hidden="true">&lt;/&gt;</span>
	</div>
</div>

<style>
	.art-stage {
		position: relative;
		width: 100%;
		aspect-ratio: 4 / 5;
		user-select: none;
		overflow: hidden;
		background:
			radial-gradient(circle at 68% 22%, color-mix(in srgb, var(--aka) 12%, transparent) 0%, transparent 50%),
			radial-gradient(circle at 48% 62%, color-mix(in srgb, var(--foreground) 5%, transparent) 0%, transparent 64%);
	}

	.workshop-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}

	.workshop-bubble {
		position: absolute;
		z-index: 3;
		transform: translate(-50%, -100%);
		max-width: min(215px, 68%);
		padding: 0.35rem 0.55rem;
		border: 1px solid var(--border);
		border-left: 2px solid var(--aka);
		border-radius: 4px;
		background: color-mix(in srgb, var(--card) 94%, transparent);
		box-shadow: 0 8px 20px -10px rgba(0, 0, 0, 0.45);
		pointer-events: none;
		display: flex;
		flex-direction: column;
		gap: 0.12rem;
	}

	.workshop-bubble[hidden] {
		display: none !important;
	}

	.workshop-bubble[data-mood='alert'] {
		border-left-width: 3px;
		border-color: color-mix(in srgb, var(--aka) 55%, var(--border));
	}

	.workshop-bubble[data-mood='celebrate'] {
		border-left-color: #7aa874;
	}

	.workshop-bubble[data-mood='celebrate'] .bubble-speaker {
		color: #7aa874;
	}

	.workshop-bubble[data-mood='joke'] {
		border-left-color: #d9a441;
	}

	.workshop-bubble[data-mood='joke'] .bubble-speaker {
		color: #d9a441;
	}

	.bubble-speaker {
		font-size: 9px;
		font-weight: 600;
		letter-spacing: 0.18em;
		color: var(--aka);
	}

	.bubble-text {
		font-size: 11px;
		line-height: 1.35;
		color: var(--foreground);
	}

	.stage-controls {
		position: absolute;
		left: 0.85rem;
		right: 0.85rem;
		bottom: 0.85rem;
		z-index: 4;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		pointer-events: none;
	}

	.stage-btn-group {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		pointer-events: auto;
	}

	.stage-btn {
		border: 1px solid var(--border);
		background: color-mix(in srgb, var(--card) 88%, transparent);
		backdrop-filter: blur(6px);
		padding: 0.35rem 0.65rem;
		border-radius: 3px;
		font-size: 10px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted-foreground);
		cursor: pointer;
		transition: border-color 150ms ease, color 150ms ease, background-color 150ms ease;
	}

	.stage-btn:hover {
		border-color: var(--aka);
		color: var(--aka);
	}

	.stage-btn[aria-pressed='true'] {
		border-color: var(--aka);
		background: var(--aka);
		color: #fdf8ee;
	}

	.stage-btn-ghost[aria-pressed='true'] {
		background: color-mix(in srgb, var(--aka) 18%, var(--card));
		color: var(--aka);
	}

	.stage-seal {
		width: 2rem;
		height: 2rem;
		border-radius: 4px;
		font-size: 10px;
		font-weight: 600;
	}
</style>

<script>
	import { initWorkshopScene } from './workshopScene';

	initWorkshopScene();
</script>
