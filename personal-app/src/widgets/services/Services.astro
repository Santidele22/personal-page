---
import { fetchServices, servicesFallback } from '../../features/service/api/services';
import EmptyState from '../../shared/ui/EmptyState.astro';
import Icon from '../../shared/ui/Icon.astro';
import Reveal from '../../shared/ui/Reveal.astro';

/* The service cards are read while the server renders the page; the fallback
   below is the copy this section shipped with before the services entity
   was consumed by the landing. */
const serverOrigin = Astro.url.origin;
const serviceCards = (await fetchServices(serverOrigin)) ?? servicesFallback;
---

<section id="servicios" class="scroll-mt-20" aria-labelledby="servicios-title">
	<div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 lg:py-24">
		<Reveal>
			<div class="max-w-xl">
				<p class="flex items-center gap-3 text-[13px] font-medium tracking-[0.25em] text-muted-foreground">
					<Icon name="code-2" class="size-4 text-aka" />
					SERVICIOS
				</p>
				<h2 id="servicios-title" class="mt-3 font-mincho text-3xl font-semibold tracking-tight sm:text-4xl">Maneras de trabajar juntos</h2>
				<p class="mt-4 text-[15px] leading-relaxed text-muted-foreground">Pocas colaboraciones, bien elegidas. Si tu proyecto encaja con el tono del diario, estas son las puertas de entrada.</p>
			</div>
		</Reveal>
		<div class="mt-12 grid gap-6 md:grid-cols-3">
			{serviceCards.length === 0 ? (
				<EmptyState
					icon="code-2"
					class="md:col-span-3"
					title="Todavía no hay servicios"
					description="Las maneras de trabajar juntos se publican acá, pocas y bien elegidas. Volvé en unos días: las puertas de entrada van a estar listas."
				/>
			) : (
				serviceCards.map((service, index) => (
				<Reveal delay={0.1 * index} class="h-full">
					<article class="group flex h-full flex-col border border-border bg-card p-7 transition-colors hover:border-aka/60">
						<div class="flex items-center justify-between">
							<span aria-hidden="true" class="flex size-11 items-center justify-center border border-aka/40 text-aka">
								<Icon name={service.icon} class="size-5" strokeWidth={1.5} />
							</span>
							<span class="text-[11px] tracking-[0.2em] text-muted-foreground">{service.num}</span>
						</div>
						<h3 class="mt-5 font-mincho text-xl font-semibold tracking-tight">{service.title}</h3>
						<p class="mt-3 text-sm leading-relaxed text-muted-foreground">{service.description}</p>
						<ul class="mt-5 flex-1 space-y-2.5 border-t border-border pt-5">
							{service.items.map((item) => (
								<li class="flex items-start gap-2.5 text-sm">
									<Icon name="check" class="mt-0.5 size-4 shrink-0 text-aka" />
									<span class="text-muted-foreground">{item}</span>
								</li>
							))}
						</ul>
						<p class="mt-6 flex items-baseline justify-between border-t border-border pt-4">
							<span class="text-[12px] tracking-wider text-muted-foreground">TARIFA</span>
							<span class="font-mincho text-lg font-semibold">{service.price}</span>
						</p>
					</article>
				</Reveal>
			))
			)}
		</div>
	</div>
</section>
