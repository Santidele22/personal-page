---
import ServiceCard from '../../entities/service/ServiceCard.astro';
import { fetchServicesPage, servicesFallback } from '../../features/service/api/services';
import EmptyState from '../../shared/ui/EmptyState.astro';
import Icon from '../../shared/ui/Icon.astro';
import Reveal from '../../shared/ui/Reveal.astro';

/* The landing only reads the first page of services (`limit=4`, issue 47
   S8); `total` decides whether the «Ver todos» link has more to point at. The
   fallback below is the copy this section shipped with before the services
   entity was consumed by the landing, capped to the same four cards. */
const serverOrigin = Astro.url.origin;
const page = await fetchServicesPage(serverOrigin, 0, 4);
const serviceCards = page?.items ?? servicesFallback.slice(0, 4);
const showAllLink = page !== null && page.total > page.items.length;
---

<section id="servicios" class="scroll-mt-20" aria-labelledby="servicios-title">
	<div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 lg:py-24">
		<Reveal>
			<div class="flex flex-wrap items-end justify-between gap-4">
				<div class="max-w-xl">
					<p class="flex items-center gap-3 text-[13px] font-medium tracking-[0.25em] text-muted-foreground">
						<Icon name="code-2" class="size-4 text-aka" />
						SERVICIOS
					</p>
					<h2 id="servicios-title" class="mt-3 font-mincho text-3xl font-semibold tracking-tight sm:text-4xl">Maneras de trabajar juntos</h2>
					<p class="mt-4 text-[15px] leading-relaxed text-muted-foreground">Pocas colaboraciones, bien elegidas. Si tu proyecto encaja con el tono del diario, estas son las puertas de entrada.</p>
				</div>
				{showAllLink && (
					<a href="/servicios/" class="group inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-aka">
						Ver todos los servicios
						<Icon name="arrow-up-right" class="size-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
					</a>
				)}
			</div>
		</Reveal>
		<div class="mt-12 grid gap-6 md:grid-cols-3">
			{serviceCards.length === 0 ? (
				<EmptyState
					icon="code-2"
					class="md:col-span-3"
					title="Todavía no hay servicios"
					description="Las maneras de trabajar juntos se publican acá, pocas y bien elegidas. Volvé en unos días: las puertas de entrada van a estar listas."
				/>
			) : (
				serviceCards.map((service, index) => (
				<Reveal delay={0.1 * index} class="h-full">
					<ServiceCard service={service} />
				</Reveal>
			))
			)}
		</div>
	</div>
</section>
