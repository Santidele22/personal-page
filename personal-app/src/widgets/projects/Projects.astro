---
import ProjectCard from '../../entities/project/ProjectCard.astro';
import { fetchProjectsPage } from '../../features/project/api/projects';
import EmptyState from '../../shared/ui/EmptyState.astro';
import Icon from '../../shared/ui/Icon.astro';
import Reveal from '../../shared/ui/Reveal.astro';
import SeigaihaBand from '../../shared/ui/SeigaihaBand.astro';
import { transitionNameSlug } from '../../shared/lib/slug';
import ProjectPurchaseDialog from '../../features/project/ProjectPurchaseDialog';
import ToolsBlock from '../blog/ToolsBlock.astro';

/* The landing only reads the first page of projects (`limit=4`, issue 47
   S8); `total` decides whether the «Ver todos» link has more to point at. A
   failed read renders the empty state: the backend is the single source of
   truth and the section never shows shipped copy (projects-type-restore L3). */
const serverOrigin = Astro.url.origin;
const page = await fetchProjectsPage(serverOrigin, 0, 4);
const projectCards = page?.items ?? [];
const showAllLink = page !== null && page.total > page.items.length;

/* The grid pins one headline card: the featured flag, or the first card when
   the admin has not marked any project as featured. */
const featured = projectCards.find((project) => project.featured) ?? projectCards[0];
const rest = projectCards.filter((project) => project !== featured);

/* Type facets for the client-side filter (projects-type-restore S6, revised
   L7): counts cover the grid cards only — the featured headline card stays
   out of the filter, it is always visible. Only rendered with two or more
   distinct grid types — a single category needs no filter. */
const gridCards = rest;
const typeFacets = [...new Map(
	gridCards.filter((project) => project.type).map((project) => [project.type, {
		value: project.type as string,
		label: project.typeLabel as string,
		count: gridCards.filter((other) => other.type === project.type).length,
	}]),
).values()];
const showFilter = typeFacets.length > 1;
---

<section id="proyectos" class="scroll-mt-20 border-y border-border bg-secondary/40" aria-labelledby="proyectos-title">
	<div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 lg:py-24">
		<Reveal>
			<div class="flex flex-wrap items-end justify-between gap-4">
				<div class="max-w-xl">
					<p class="flex items-center gap-3 text-[13px] font-medium tracking-[0.25em] text-muted-foreground">
						<Icon name="blocks" class="size-4 text-aka" />
						PROYECTOS
					</p>
					<h2 id="proyectos-title" class="mt-3 font-mincho text-3xl font-semibold tracking-tight sm:text-4xl">Cosas que construyo con las manos</h2>
					<p class="mt-4 text-[15px] leading-relaxed text-muted-foreground">Proyectos reales, con código abierto y sin promesas infladas: algunos en producción, otros todavía en el banco de trabajo.</p>
				</div>
				{showAllLink && (
					<a href="/proyectos/" class="group inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-aka">
						Ver todos los proyectos
						<Icon name="arrow-up-right" class="size-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
					</a>
				)}
			</div>
		</Reveal>
		{showFilter && (
			<Reveal delay={0.06}>
				<div class="mt-8 flex flex-wrap items-center gap-2.5" role="group" aria-label="Filtrar proyectos por tipo">
					<span class="text-[11px] font-medium tracking-[0.2em] text-muted-foreground">TIPO</span>
					<button
						type="button"
						data-project-chip
						data-project-value="all"
						aria-pressed="true"
						data-project-active
						class="rounded-sm border border-border px-3.5 py-1.5 text-xs font-medium tracking-wide text-muted-foreground transition-colors hover:border-aka/60 hover:text-aka"
					>
						Todos<span class="ml-1.5 font-mono text-[10px] opacity-70">{gridCards.length}</span>
					</button>
					{typeFacets.map((facet) => (
						<button
							type="button"
							data-project-chip
							data-project-value={facet.value}
							aria-pressed="false"
							class="rounded-sm border border-border px-3.5 py-1.5 text-xs font-medium tracking-wide text-muted-foreground transition-colors hover:border-aka/60 hover:text-aka"
						>
							{facet.label}<span class="ml-1.5 font-mono text-[10px] opacity-70">{facet.count}</span>
						</button>
					))}
				</div>
				<p class="mt-3 text-[13px] text-muted-foreground" aria-live="polite">
					<span data-project-count>{gridCards.length} proyectos</span>
					<button type="button" data-project-clear class="ml-3 hidden text-[12.5px] text-aka underline underline-offset-2">Quitar filtro</button>
				</p>
			</Reveal>
		)}
		{/* Two columns from md up: the projects keep the wide column and the
		    tools band becomes a tall side panel (narrower at md, roomier at lg).
		    Below md the grid collapses to a single column, so the section still
		    reads header → projects → tools on mobile. */}
		<div class="mt-10 grid gap-y-8 md:grid-cols-[minmax(0,1fr)_16rem] md:items-start md:gap-x-8 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-x-10">
			{/* The data attribute marks the height reference the tools panel
		    clamps itself to (see ToolsBlock): the band is never taller than the
		    projects column. */}
		<div class="min-w-0" data-projects-column>
		{/* The headline card only exists when the backend serves at least one
		    project: an empty list renders the section without cards instead of
		    falling back to the shipped copy. */}
		{projectCards.length > 0 && (
			<Reveal delay={0.1}>
			<article data-project-type={featured.type ?? ''} data-project-featured transition:name={`project-card-${transitionNameSlug(featured.name)}`} class="group grid overflow-hidden border border-border bg-card transition-colors hover:border-aka/60 lg:grid-cols-2">
				<div class="relative flex min-h-[240px] items-center justify-center overflow-hidden border-b border-border bg-secondary/60 lg:border-b-0 lg:border-r">
					<SeigaihaBand class="absolute inset-x-0 top-0 h-24 text-foreground opacity-[0.16]" rows={3} />
					<SeigaihaBand class="absolute inset-x-0 bottom-0 h-24 rotate-180 text-foreground opacity-[0.1]" rows={3} />
					<Icon name={featured.icon} class="relative size-24 text-aka" strokeWidth={1} />
					<span class="absolute left-4 top-4 flex flex-col items-start gap-1.5">
					<span class="rounded-full border border-aka/40 bg-background/80 px-3 py-1 text-[11px] font-medium tracking-wider text-aka backdrop-blur-sm">{featured.statusLabel.toUpperCase()}</span>
					{featured.typeLabel && <span class="rounded-full border border-aka/40 bg-background/80 px-3 py-1 text-[11px] font-medium tracking-wider text-aka backdrop-blur-sm">{featured.typeLabel.toUpperCase()}</span>}
				</span>
				</div>
				<div class="flex flex-col p-6 sm:p-9">
					<h3 class="text-balance font-mincho text-2xl font-semibold leading-snug tracking-tight sm:text-[1.7rem]">{featured.name}</h3>
					<p class="mt-1 text-sm font-medium text-aka">{featured.tagline}</p>
					<p class="mt-4 flex-1 text-[15px] leading-relaxed text-muted-foreground">{featured.description}</p>
					<ul class="mt-5 flex flex-wrap gap-1.5">
						{featured.stack.map((tech) => <li class="rounded-sm bg-secondary px-2 py-0.5 text-[11px] font-medium tracking-wide text-foreground/80">{tech}</li>)}
					</ul>
					<div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-border pt-4">
						{featured.repoUrl && (
							<a href={featured.repoUrl} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1.5 text-sm font-medium text-aka hover:underline">
								<Icon name="github" class="size-4" />
								Código
							</a>
						)}
						{featured.demoUrl && (
							<a href={featured.demoUrl} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1.5 text-sm font-medium text-aka hover:underline">
								Demo
								<Icon name="arrow-up-right" class="size-4" />
							</a>
						)}
						{featured.forSale && <ProjectPurchaseDialog projectName={featured.name} client:load />}
					</div>
				</div>
			</article>
			</Reveal>
		)}
		{projectCards.length === 0 && (
			<Reveal delay={0.1}>
				<EmptyState
					icon="blocks"
					title="Todavía no hay proyectos"
					description="Están en el banco de trabajo: cuando uno salga, acá vas a ver el código, la demo y el stack de cada uno."
				/>
			</Reveal>
		)}
		{rest.length > 0 && (
			<div class="mt-6 grid gap-6 lg:grid-cols-2">
			{rest.map((project, index) => (
				<Reveal delay={0.1 * index} class="h-full">
					<ProjectCard project={project} />
				</Reveal>
			))}
			</div>
		)}
			</div>

		{/* The projects show what was built; the tools band sits beside them
		    from md up with the real, backend-managed list of what built it. Each
		    entry keeps the love-of-art vs sponsored split; tools without a
		    managed link fall back to the dedicated /marcas page. `md:self-stretch`
		    cancels the grid's `md:items-start` for this one item so the wrapper
		    spans the full row height: that wrapper is the containing block the
		    sticky aside (see ToolsBlock) travels in while the projects column
		    scrolls past — without it the wrapper only hugs its content and the
		    band stays pinned at the top (nothing to stick against). */}
		<Reveal class="md:self-stretch">
			<ToolsBlock label="CON LO QUE LOS CONSTRUYO" class="md:sticky md:top-24" />
		</Reveal>
		</div>
	</div>
</section>

<script>
/* Client-side type filter (projects-type-restore S6, revised L7): the chips
   toggle only the grid cards — the featured headline card is presentation
   and always stays visible. The active chip swaps to ink-on-ink via a class
   so the background change is one class toggle, and the count line reports
   the grid state. */
const filterSection = document.getElementById('proyectos');
const filterChips = filterSection
	? [...filterSection.querySelectorAll<HTMLButtonElement>('[data-project-chip]')]
	: [];
if (filterChips.length > 0) {
	const cards = [...filterSection!.querySelectorAll<HTMLElement>('[data-project-type]')]
		.filter((card) => !card.hasAttribute('data-project-featured'));
	const ACTIVE = 'data-project-active';
	const count = filterSection!.querySelector<HTMLElement>('[data-project-count]');
	const clearButton = filterSection!.querySelector<HTMLButtonElement>('[data-project-clear]');
	const total = cards.length;

	const applyFilter = (value: string) => {
		let visible = 0;
		for (const card of cards) {
			const show = value === 'all' || card.dataset.projectType === value;
			card.closest<HTMLElement>('.reveal')?.classList.toggle('hidden', !show);
			if (show) visible += 1;
		}
		for (const chip of filterChips) {
			const active = chip.dataset.projectValue === value;
			chip.setAttribute('aria-pressed', String(active));
			chip.toggleAttribute(ACTIVE, active);
		}
		if (count) count.textContent = visible === total ? `${total} proyectos` : `${visible} de ${total} proyectos`;
		clearButton?.classList.toggle('hidden', value === 'all');
	};

	for (const chip of filterChips) {
		chip.addEventListener('click', () => applyFilter(chip.dataset.projectValue ?? 'all'));
	}
	clearButton?.addEventListener('click', () => applyFilter('all'));
}
</script>
