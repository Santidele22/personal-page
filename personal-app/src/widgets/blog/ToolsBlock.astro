---
import { fetchTools, toolsFallback } from '../../features/tool/api/tools';
import Icon from '../../shared/ui/Icon.astro';

/* The tools are read while the server renders the page; the fallback below is
   the list this grid shipped with before the tools entity existed. */
const serverOrigin = import.meta.env.DEV ? Astro.url.origin : undefined;
const toolList = (await fetchTools(serverOrigin)) ?? toolsFallback;

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<aside aria-label="Herramientas que uso, con enlaces de afiliado" class={className}>
	<div class="flex h-full flex-col border border-border bg-card p-6">
		<p class="flex items-center gap-2 text-[11px] font-medium tracking-[0.2em] text-muted-foreground">
			<Icon name="wrench" class="size-3.5 text-aka" />
			HERRAMIENTAS QUE USO
		</p>
		{toolList.length === 0 ? (
			<p class="mt-4 text-sm leading-relaxed text-muted-foreground">Pronto va a haber herramientas nuevas acá.</p>
		) : (
			<ul class="mt-4 flex-1 space-y-4">
				{toolList.map((tool) => (
				<li>
					<a href="#marcas" class="group flex items-start justify-between gap-3">
						<span>
							<span class="block text-sm font-semibold transition-colors group-hover:text-aka">{tool.name}</span>
							<span class="mt-0.5 block text-[12px] leading-snug text-muted-foreground">{tool.what}</span>
						</span>
						<Icon name="arrow-up-right" class="mt-0.5 size-4 shrink-0 text-muted-foreground transition-all group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-aka" />
					</a>
				</li>
			))}
			</ul>
		)}
		<p class="mt-5 border-t border-border pt-3 text-[11px] leading-relaxed text-muted-foreground">Enlaces de afiliado: si comprás, me llega una comisión sin costo extra para vos. Solo listo lo que uso de verdad.</p>
	</div>
</aside>
