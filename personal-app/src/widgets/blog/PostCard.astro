---
import type { Post } from '../../entities/post/types';
import Icon from '../../shared/ui/Icon.astro';

/* One portada card of the diario grid. The whole card is the link to the
   post page the content collection generates; the title shares the same
   view-transition name the layout puts on the post's heading. */
interface Props {
	post: Post;
}

const { post } = Astro.props;
---

<a href={`/blog/${post.slug}/`} class="group flex h-full flex-col border border-border bg-card p-6 transition-colors hover:border-aka/60">
	<div class="flex items-start justify-between gap-3">
		<span aria-hidden="true" class="flex size-9 items-center justify-center border border-aka/40 text-aka">
			<Icon name={post.icon} class="size-4" strokeWidth={1.75} />
		</span>
		<p class="text-right text-[11px] leading-tight tracking-wider text-muted-foreground">
			<time datetime={post.date.replaceAll('.', '-')}>{post.date}</time>
			<br />
			{post.readMin} min
		</p>
	</div>
	<h3 transition:name={`blog-title-${post.slug}`} class="mt-5 text-balance font-mincho text-lg font-semibold leading-snug tracking-tight">{post.title}</h3>
	<p class="mt-3 flex-1 text-sm leading-relaxed text-muted-foreground">{post.excerpt}</p>
	<p class="mt-5 flex items-center justify-between border-t border-border pt-4">
		<span class="rounded-sm bg-secondary px-2 py-0.5 text-[11px] font-medium text-foreground/80">{post.category}</span>
		<Icon name="arrow-up-right" class="size-4 text-muted-foreground transition-all group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-aka" />
	</p>
</a>
