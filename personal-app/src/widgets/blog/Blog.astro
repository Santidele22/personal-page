---
import AdSlot from '../../entities/ad-slot/AdSlot.astro';
import { adSlots } from '../../entities/ad-slot/data';
import { posts } from '../../entities/post/data';
import Icon from '../../shared/ui/Icon.astro';
import Reveal from '../../shared/ui/Reveal.astro';
import SeigaihaBand from '../../shared/ui/SeigaihaBand.astro';
import PostCard from './PostCard.astro';
import ToolsBlock from './ToolsBlock.astro';

const featured = posts.find((post) => post.featured)!;
const rest = posts.filter((post) => !post.featured);
const row1 = rest.slice(0, 2);
const row2 = rest.slice(2, 4);
const flujo = adSlots.find((slot) => slot.id === 'flujo')!;
---

<section id="diario" class="scroll-mt-20" aria-labelledby="diario-title">
	<div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 lg:py-24">
		<Reveal>
			<div class="flex flex-wrap items-end justify-between gap-4">
				<div>
					<p class="flex items-center gap-3 text-[13px] font-medium tracking-[0.25em] text-muted-foreground">
						<Icon name="book-open" class="size-4 text-aka" />
						EL DIARIO
					</p>
					<h2 id="diario-title" class="mt-3 font-mincho text-3xl font-semibold tracking-tight sm:text-4xl">Entradas recientes</h2>
				</div>
				<a href="/blog/" class="group inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-aka">
					Ver archivo completo
					<Icon name="arrow-up-right" class="size-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
				</a>
			</div>
		</Reveal>
		<Reveal delay={0.1}>
			<article class="group mt-10 grid overflow-hidden border border-border bg-card transition-colors hover:border-aka/60 md:grid-cols-2">
				<div class="relative flex min-h-[240px] items-center justify-center overflow-hidden border-b border-border bg-secondary/60 md:border-b-0 md:border-r">
					<SeigaihaBand class="absolute inset-x-0 top-0 h-24 text-foreground opacity-[0.16]" rows={3} />
					<SeigaihaBand class="absolute inset-x-0 bottom-0 h-24 rotate-180 text-foreground opacity-[0.1]" rows={3} />
					<Icon name={featured.icon} class="relative size-24 text-aka" strokeWidth={1} />
					<span class="absolute left-4 top-4 rounded-full border border-aka/40 bg-background/80 px-3 py-1 text-[11px] font-medium tracking-wider text-aka backdrop-blur-sm">DESTACADO</span>
				</div>
				<div class="flex flex-col p-6 sm:p-9">
					<p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[12px] tracking-wider text-muted-foreground">
						<span class="rounded-sm bg-secondary px-2 py-0.5 font-medium text-foreground/80">{featured.category}</span>
						<time datetime={featured.date.replaceAll('.', '-')}>{featured.date}</time>
						<span aria-hidden="true">·</span>
						<span>{featured.readMin} min de lectura</span>
					</p>
					<h3 class="mt-4 text-balance font-mincho text-2xl font-semibold leading-snug tracking-tight sm:text-[1.7rem]">{featured.title}</h3>
					<p class="mt-4 flex-1 text-[15px] leading-relaxed text-muted-foreground">{featured.excerpt}</p>
					<span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-aka">
						Leer entrada
						<Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
					</span>
				</div>
			</article>
		</Reveal>
		<div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{row1.map((post) => <Reveal class="h-full"><PostCard post={post} /></Reveal>)}
			<Reveal class="h-full"><ToolsBlock class="h-full" /></Reveal>
		</div>
		<Reveal><AdSlot ad={flujo} class="mx-auto mt-6 w-full max-w-xl" /></Reveal>
		<div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{row2.map((post) => <Reveal class="h-full"><PostCard post={post} /></Reveal>)}
			<Reveal class="h-full">
				<a href="/blog/" class="group flex h-full flex-col justify-between border border-border bg-card p-6 transition-colors hover:border-aka/60">
					<div>
						<h3 class="text-balance font-mincho text-lg font-semibold leading-snug tracking-tight">Ver todas las entradas</h3>
						<p class="mt-3 text-sm leading-relaxed text-muted-foreground">El archivo completo del diario, desde 2026: backend, blockchain y cuadernos de código.</p>
					</div>
					<p class="mt-5 flex items-center justify-between border-t border-border pt-4 text-sm font-medium text-aka">
						Ir al archivo
						<Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
					</p>
				</a>
			</Reveal>
		</div>
	</div>
</section>
