---
import BookCard from '../../entities/book/BookCard.astro';
import { fetchBooksPage } from '../../features/book/api/books';
import EmptyState from '../../shared/ui/EmptyState.astro';
import Icon from '../../shared/ui/Icon.astro';
import Reveal from '../../shared/ui/Reveal.astro';

/* The landing only reads the first page of published books (`limit=4` with
   the server-side `published=true` filter, issue 47 S5/S8); `total` counts
   every published book, so it decides whether the «Ver todos» link has more
   to point at. A failed read renders the empty shelf: the backend is the
   single source of truth and the section never shows shipped copy
   (projects-type-restore L3). */
const serverOrigin = Astro.url.origin;
const page = await fetchBooksPage(serverOrigin, 0, 4, true);
const reading = page?.items ?? [];
const showAllLink = page !== null && page.total > page.items.length;

/* The PDF download goes through the rate-limited endpoint; the absolute URL
   keeps the link working the same once the browser opens it in a new tab. */
const downloadUrl = (id: number) => `${serverOrigin}/api/books/${id}/download`;

/* Issue 23: the landing splits the shelf into two filterable groups the admin
   classifies per book (`book.kind`). Books without an explicit kind land on
   the non-technical shelf, the same default the backend column applies. The
   toggle (client script below) shows one shelf at a time; the server-side
   default is the first shelf with books, so the filter never opens empty. */
const shelves: { title: string; description: string; books: typeof reading }[] = [
	{ title: 'Técnicos', description: 'Desarrollo, arquitectura, testing y demás lectura de oficio.', books: reading.filter((book) => book.kind === 'tecnico') },
	{
		title: 'No técnicos',
		description: 'Novelas, ensayo general y lo que leo fuera del código.',
		books: reading.filter((book) => book.kind !== 'tecnico'),
	},
];
const defaultShelf = Math.max(
	0,
	shelves.findIndex((shelf) => shelf.books.length > 0),
);
---

<section id="lectura" class="scroll-mt-20 border-y border-border bg-secondary/40" aria-labelledby="lectura-title">
	<div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 lg:py-24">
		<Reveal>
			<div class="flex flex-wrap items-end justify-between gap-4">
				<div class="max-w-xl">
					<p class="flex items-center gap-3 text-[13px] font-medium tracking-[0.25em] text-muted-foreground">
						<Icon name="book-open" class="size-4 text-aka" />
						APRENDER DESPACIO
					</p>
					<h2 id="lectura-title" class="mt-3 font-mincho text-3xl font-semibold tracking-tight sm:text-4xl">Lo que estoy leyendo</h2>
					<p class="mt-4 text-[15px] leading-relaxed text-muted-foreground">Aprender despacio también se entrena: los libros que tengo entre manos, con la reseña cuando los termino y el PDF para descargar si te lo querés llevar.</p>
				</div>
				{showAllLink && (
					<a href="/lecturas/" class="group inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-aka">
						Ver todas las lecturas
						<Icon name="arrow-up-right" class="size-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
					</a>
				)}
			</div>
		</Reveal>
		{/* An empty list renders the section without cards instead of falling
		    back to the shipped copy: the backend is the only source of truth. */}
		{reading.length === 0 && (
			<Reveal delay={0.1} class="mt-10">
				<EmptyState
					icon="book-open"
					title="Todavía no hay libros"
					description="Cuando haya títulos publicados, acá vas a ver qué estoy leyendo, la reseña y el PDF de cada uno."
				/>
			</Reveal>
		)}
		{reading.length > 0 && (
			<div class="mt-10 flex flex-wrap items-center gap-2" id="lectura-filter" role="group" aria-label="Filtrar libros por tipo">
				{shelves.map((shelf, index) => (
					<button
						type="button"
						data-shelf={index}
						aria-pressed={index === defaultShelf}
						class="inline-flex items-center gap-2 border border-border px-4 py-2 text-sm font-medium text-muted-foreground transition-colors hover:border-aka/40 aria-[pressed=true]:border-aka/60 aria-[pressed=true]:bg-card aria-[pressed=true]:text-foreground"
					>
						{shelf.title}
						<span class="text-[11px] text-muted-foreground" aria-hidden="true">{shelf.books.length}</span>
					</button>
				))}
			</div>
		)}
		{reading.length > 0 && (
			shelves.map((shelf, index) => (
				<div class="mt-8" data-shelf-panel={index} hidden={index !== defaultShelf}>
					<h3 class="font-mincho text-2xl font-semibold tracking-tight">{shelf.title}</h3>
					<p class="mt-1 text-[13px] text-muted-foreground">{shelf.description}</p>
					{shelf.books.length === 0 && (
						<p class="mt-6 border border-border bg-card p-6 text-sm text-muted-foreground">
							Todavía no hay libros en este apartado.
						</p>
					)}
					{shelf.books.length > 0 && (
						<div class="mt-6 grid gap-6 md:grid-cols-2">
							{shelf.books.map((book, index) => (
								<Reveal delay={0.1 * index} class="h-full">
									<BookCard book={book} downloadUrl={downloadUrl(book.id)} />
								</Reveal>
							))}
						</div>
					)}
				</div>
			))
		)}
	</div>
</section>

<script>
	// Toggle filter (issue 23): the buttons switch between the two kind
	// shelves; `aria-pressed` carries the active state (the styles key on it).
	const filter = document.getElementById('lectura-filter');
	const panels = [...document.querySelectorAll<HTMLElement>('[data-shelf-panel]')];

	filter?.querySelectorAll<HTMLButtonElement>('button[data-shelf]').forEach((button) => {
		button.addEventListener('click', () => {
			const shelf = button.dataset.shelf ?? '';

			filter.querySelectorAll('button[data-shelf]').forEach((other) => {
				other.setAttribute('aria-pressed', String(other === button));
			});
			panels.forEach((panel) => {
				panel.hidden = panel.dataset.shelfPanel !== shelf;
			});
		});
	});
</script>
