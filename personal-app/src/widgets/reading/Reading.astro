---
import { fetchBooks, booksFallback } from '../../features/book/api/books';
import EmptyState from '../../shared/ui/EmptyState.astro';
import Icon from '../../shared/ui/Icon.astro';
import Reveal from '../../shared/ui/Reveal.astro';
import SeigaihaBand from '../../shared/ui/SeigaihaBand.astro';

/* The reading cards are read while the server renders the page; the fallback
   below is the empty shelf this section shipped with before the books entity
   was consumed by the landing. */
const serverOrigin = Astro.url.origin;
const reading = (await fetchBooks(serverOrigin)) ?? booksFallback;

/* The PDF download goes through the rate-limited endpoint; the absolute URL
   keeps the link working the same once the browser opens it in a new tab. */
const downloadUrl = (id: number) => `${serverOrigin}/api/books/${id}/download`;
---

<section id="lectura" class="scroll-mt-20 border-y border-border bg-secondary/40" aria-labelledby="lectura-title">
	<div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 lg:py-24">
		<Reveal>
			<div class="max-w-xl">
				<p class="flex items-center gap-3 text-[13px] font-medium tracking-[0.25em] text-muted-foreground">
					<Icon name="book-open" class="size-4 text-aka" />
					LECTURA
				</p>
				<h2 id="lectura-title" class="mt-3 font-mincho text-3xl font-semibold tracking-tight sm:text-4xl">Lo que estoy leyendo</h2>
				<p class="mt-4 text-[15px] leading-relaxed text-muted-foreground">Los libros que tengo entre manos, con la reseña cuando los termino y el PDF para descargar si te lo querés llevar.</p>
			</div>
		</Reveal>
		{/* An empty list renders the section without cards instead of falling
		    back to the shipped copy: the backend is the only source of truth. */}
		{reading.length === 0 && (
			<Reveal delay={0.1} class="mt-10">
				<EmptyState
					icon="book-open"
					title="Todavía no hay libros"
					description="Cuando haya títulos publicados, acá vas a ver qué estoy leyendo, la reseña y el PDF de cada uno."
				/>
			</Reveal>
		)}
		{reading.length > 0 && (
			<div class="mt-10 grid gap-6 md:grid-cols-2">
			{reading.map((book, index) => (
				<Reveal delay={0.1 * index} class="h-full">
					<article class="group relative flex h-full flex-col overflow-hidden border border-border bg-card p-7 transition-colors hover:border-aka/60">
						<SeigaihaBand class="pointer-events-none absolute inset-x-0 top-0 h-16 text-foreground opacity-[0.08]" rows={2} />
						<div class="relative flex items-start justify-between gap-4">
							<span aria-hidden="true" class="flex size-11 shrink-0 items-center justify-center border border-aka/40 text-aka">
								<Icon name="book-open" class="size-5" strokeWidth={1.5} />
							</span>
							<span class="rounded-sm bg-secondary px-2 py-0.5 text-[11px] font-medium tracking-wide text-foreground/80">{book.statusLabel}</span>
						</div>
						<h3 class="relative mt-5 font-mincho text-xl font-semibold tracking-tight">{book.title}</h3>
						<p class="relative mt-1 text-sm font-medium text-aka">{book.author}</p>
						<p class="relative mt-3 text-sm leading-relaxed text-muted-foreground">{book.description}</p>
						{book.review && (
							<blockquote class="relative mt-4 border-l-2 border-aka/40 pl-4 text-sm italic leading-relaxed text-muted-foreground">{book.review}</blockquote>
						)}
						{book.published && (
							<p class="relative mt-6 border-t border-border pt-4">
								<a href={downloadUrl(book.id)} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1.5 text-sm font-medium text-aka hover:underline">
									<Icon name="download" class="size-4" />
									Descargar PDF
								</a>
							</p>
						)}
					</article>
				</Reveal>
			))}
			</div>
		)}
	</div>
</section>
