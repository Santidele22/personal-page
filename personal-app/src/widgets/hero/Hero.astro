---
import { fetchProfile } from '../../features/profile/api/profile';
import Icon from '../../shared/ui/Icon.astro';
import Reveal from '../../shared/ui/Reveal.astro';

/* The profile is read while the server renders the page. A failed read leaves
   the copy empty: the backend is the single source of truth and the hero
   never shows shipped text (projects-type-restore L3). */
const serverOrigin = Astro.url.origin;
const profile = await fetchProfile(serverOrigin);

const eyebrow = profile?.eyebrow ?? '';

/* `heroTitle` is stored with its final period, which the design renders inside
   the accent span: take it out of the text and keep it in the span. */
const heroTitle = profile?.heroTitle ?? '';
const titleText = heroTitle.endsWith('.') ? heroTitle.slice(0, -1) : heroTitle;
const titlePeriod = heroTitle.endsWith('.');

const heroIntro = profile?.heroIntro ?? '';

const commitments = profile?.commitments ?? [];
---

<section
	class="relative flex min-h-[min(760px,calc(100vh-4rem))] flex-col justify-center overflow-hidden border-b border-border"
	aria-labelledby="hero-title"
>
	<div
		id="duneStage"
		class="absolute inset-0 z-[1] touch-pan-y select-none cursor-grab active:cursor-grabbing lg:touch-none"
		tabindex="0"
		role="img"
		aria-label="Escena 3D a pantalla completa: dunas de arena en movimiento, un umbral brutalista colosal partido por la mitad con cicatrices kintsugi e inscripciones talladas en la piedra, un haz de luz roja derramándose sobre la escalinata ceremonial, la sombra larga de los monolitos sobre las crestas y una silueta humana diminuta sosteniendo su códice abierto al pie del monumento. Arrastrá para orbitar o hacé clic para abrir el umbral y calmar la tormenta."
	>
		<canvas id="duneCanvas" class="block size-full"></canvas>
	</div>

	<div class="hero-readability-veil pointer-events-none absolute inset-0 z-[2]" aria-hidden="true"></div>

	<div class="pointer-events-none relative z-[3] mx-auto grid w-full max-w-6xl gap-10 px-5 pb-10 pt-12 sm:px-8 sm:pb-12 sm:pt-14 lg:grid-cols-[minmax(0,36rem)_1fr] lg:items-center lg:py-16">
		<div class="pointer-events-auto">
			{eyebrow && (
				<Reveal>
					<p class="flex items-center gap-3 text-[13px] font-medium tracking-[0.25em] text-muted-foreground">
						<span aria-hidden="true" class="inline-block h-px w-10 bg-aka"></span>
						{eyebrow}
					</p>
				</Reveal>
			)}
			{heroTitle && (
				<Reveal delay={0.08}>
					<h1 id="hero-title" class="mt-5 max-w-[16ch] text-balance font-mincho text-[clamp(2.4rem,5.2vw,3.8rem)] font-semibold leading-[1.1] tracking-[-0.025em]">
						{titleText}{titlePeriod && <span class="text-aka">.</span>}
					</h1>
				</Reveal>
			)}
			{heroIntro && (
				<Reveal delay={0.16}>
					<p class="mt-5 max-w-[31rem] text-[15.5px] leading-[1.72] text-muted-foreground sm:text-base">
						{heroIntro}
					</p>
				</Reveal>
			)}
			<Reveal delay={0.24}>
				<div class="mt-8 flex flex-wrap items-center gap-3">
					<a href="#diario" class="group inline-flex items-center gap-2 rounded-md bg-foreground px-6 py-3 text-sm font-medium text-background transition-colors hover:bg-aka hover:text-[#fdf8ee]">
						Abrir el diario
						<Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-0.5" />
					</a>
					<a href="#quien-soy" class="inline-flex items-center rounded-md border border-border bg-card/75 px-6 py-3 text-sm font-medium transition-colors hover:border-aka hover:text-aka">Quién soy</a>
					<a href="/manifiesto" class="inline-flex items-center rounded-md border border-border bg-card/75 px-6 py-3 text-sm font-medium transition-colors hover:border-aka hover:text-aka">Manifiesto</a>
				</div>
			</Reveal>
			{commitments.length > 0 && (
				<Reveal delay={0.32}>
					<dl class="mt-11 grid max-w-[28rem] grid-cols-3 divide-x divide-border border-y border-border py-[1.15rem]">
						{commitments.map((item) => (
							<div class="flex flex-col px-4 first:pl-0 last:pr-0">
								<dt class="order-2 mt-1 text-[11px] leading-[1.35] text-muted-foreground">{item.label}</dt>
								<dd class="order-1 font-mincho text-[1.4rem] font-semibold leading-[1.2] text-foreground">{item.value}</dd>
							</div>
						))}
					</dl>
				</Reveal>
			)}
		</div>

		<div class="h-[250px] lg:hidden" aria-hidden="true"></div>
	</div>

	<div class="pointer-events-none relative z-[3] mx-auto mt-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-border/75 px-5 pb-5 pt-3.5 font-mono text-[10.5px] uppercase tracking-[0.2em] text-muted-foreground sm:px-8 sm:pb-[1.35rem] sm:pt-[0.9rem]">
		<div class="inline-flex items-center gap-3.5">
			<span class="size-1.5 rounded-full bg-aka" aria-hidden="true"></span>
			<span id="telemetryState" aria-live="polite">TORMENTA EN LA ARENA · UMBRAL EN PIE</span>
		</div>
		<div class="inline-flex flex-wrap items-center gap-3.5">
			<span>ARRASTRÁ PARA ORBITAR · CLIC PARA ABRIR</span>
			<button
				type="button"
				id="holdHelmBtn"
				class="pointer-events-auto inline-flex items-center gap-2 rounded-md border border-border bg-card/85 px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-foreground transition-colors hover:border-aka hover:text-aka aria-[pressed=true]:border-aka aria-[pressed=true]:bg-aka aria-[pressed=true]:text-[#fdf8ee]"
				aria-pressed="false"
			>
				Calmar la tormenta
			</button>
		</div>
	</div>
</section>

<style>
	.hero-readability-veil {
		background: linear-gradient(
			95deg,
			color-mix(in srgb, var(--background) 92%, transparent) 0%,
			color-mix(in srgb, var(--background) 80%, transparent) 38%,
			color-mix(in srgb, var(--background) 22%, transparent) 62%,
			transparent 82%
		);
	}

	@media (max-width: 1023px) {
		.hero-readability-veil {
			background: linear-gradient(
				180deg,
				color-mix(in srgb, var(--background) 92%, transparent) 0%,
				color-mix(in srgb, var(--background) 84%, transparent) 48%,
				color-mix(in srgb, var(--background) 32%, transparent) 78%,
				transparent 100%
			);
		}
	}
</style>

<script>
	import { initDuneHero } from './duneScene';
	initDuneHero();
</script>
