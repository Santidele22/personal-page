---
import { GITHUB_URL, LINKEDIN_URL } from '../../app/config/site';
import AdSlot from '../../entities/ad-slot/AdSlot.astro';
import { adSlotsFallback, fetchAdSlots } from '../../features/ad-slot/api/ad-slots';
import { fetchProfile } from '../../features/profile/api/profile';
import Icon from '../../shared/ui/Icon.astro';
import type { IconName } from '../../shared/ui/Icon.astro';

/* The profile and the footer seal are read while the server renders the page;
   the fallbacks below are the copy this footer shipped with before the profile
   entity existed. */
const serverOrigin = import.meta.env.DEV ? Astro.url.origin : undefined;
const [profile, adSlots] = await Promise.all([
	fetchProfile(serverOrigin),
	fetchAdSlots(serverOrigin),
]);
const slots = adSlots ?? adSlotsFallback;

/* The site name is stored with the accent period the design paints in aka. */
const siteName = profile?.siteName || 'santi.';
const siteNameText = siteName.endsWith('.') ? siteName.slice(0, -1) : siteName;
const siteNamePeriod = siteName.endsWith('.');

const blurb =
	profile?.footerBlurb ||
	'Web personal y diario sobre backend, blockchain e ingeniería de software. Escrito despacio desde 2026.';

/* Copyright is stored verbatim (year included); only the offline fallback
   rebuilds the current year, exactly as this footer used to. */
const year = new Date().getFullYear();
const copyright = profile?.footerCopyright || `© ${year} santi — Todos los textos son míos; el código también.`;

type SocialLink = { icon: IconName; label: string; href: string };

const socials: SocialLink[] = [
	{ icon: 'rss', label: 'RSS del diario', href: '/rss.xml' },
	{ icon: 'github', label: 'GitHub', href: profile?.githubUrl || GITHUB_URL },
	{ icon: 'linkedin', label: 'LinkedIn', href: profile?.linkedinUrl || LINKEDIN_URL },
];

const columns = [
	{
		title: 'Diario',
		links: [
			{ label: 'Entradas recientes', href: '/#diario' },
			{ label: 'Quién soy', href: '/#quien-soy' },
			{ label: 'Proyectos', href: '/#proyectos' },
			{ label: 'Servicios', href: '/#servicios' },
		],
	},
	{
		title: 'Marcas',
		links: [
			{ label: 'Espacios publicitarios', href: '/#marcas' },
			{ label: 'Tarifa completa', href: '/#contacto' },
			{ label: 'Ética publicitaria', href: '/#marcas' },
		],
	},
];
const pie = slots.find((slot) => slot.id === 'pie');
---

<footer class="mt-auto border-t border-border bg-card/60">
	<div class="relative mx-auto max-w-6xl overflow-hidden px-5 pb-8 pt-12 sm:px-8">
		<span aria-hidden="true" class="pointer-events-none absolute -bottom-14 right-4 select-none font-mono text-[9rem] font-bold leading-none text-foreground opacity-[0.04]">&lt;/&gt;</span>
		{pie && <AdSlot ad={pie} class="mx-auto w-full max-w-md opacity-90" />}
		<div class="mt-12 grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
			<div>
				<p class="flex items-center gap-3">
					<span class="hanko size-8 rounded-[4px] font-mono text-[10px] font-semibold">&lt;/&gt;</span>
					<span class="font-mincho text-xl font-semibold">{siteNameText}{siteNamePeriod && <span class="text-aka">.</span>}</span>
				</p>
				<p class="mt-4 max-w-xs text-[13px] leading-relaxed text-muted-foreground">{blurb}</p>
				<div class="mt-5 flex items-center gap-2">
					{socials.map((social) => {
						const isExternal = social.href.startsWith('http');
						return (
							<a
								href={social.href}
								aria-label={social.label}
								target={isExternal ? '_blank' : undefined}
								rel={isExternal ? 'noreferrer' : undefined}
								data-astro-reload={social.href === '/rss.xml' ? true : undefined}
								class="inline-flex size-9 items-center justify-center rounded-md border border-border bg-card text-muted-foreground transition-colors hover:border-aka hover:text-aka"
							>
								<Icon name={social.icon} class="size-4" />
							</a>
						);
					})}
				</div>
			</div>
			{columns.map((column) => (
				<nav aria-label={column.title}>
					<h2 class="text-[12px] font-semibold tracking-[0.25em] text-foreground/80">{column.title}</h2>
					<ul class="mt-4 space-y-2.5">
						{column.links.map((link) => <li><a href={link.href} class="text-[13px] text-muted-foreground transition-colors hover:text-aka">{link.label}</a></li>)}
					</ul>
				</nav>
			))}
		</div>
		<div class="mt-12 flex flex-wrap items-center justify-between gap-3 border-t border-border pt-6 text-[12px] text-muted-foreground">
			<p>{copyright}</p>
			<p class="tracking-wide">hecho despacio · deploy con calma</p>
		</div>
	</div>
</footer>
