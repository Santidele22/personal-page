# Base URL de la API. `/api` usa el proxy de Vite en desarrollo y el Worker en
# producción. Una URL absoluta sigue soportada; su origen entra en la directiva
# CSP `connect-src` durante el build y necesita CORS en Render:
# PUBLIC_API_BASE_URL=https://personal-page-backend-ahbb.onrender.com/api
PUBLIC_API_BASE_URL=/api

# Origen del backend para el proxy SSR `/api/*`. En Cloudflare Workers:
# BACKEND_URL=https://personal-page-backend-ahbb.onrender.com
BACKEND_URL=http://localhost:3000

# Managed Better Auth del branch Neon `main`. Solo se usa en producción para
# proxy same-origin de `/api/auth/*`; copiar la URL completa con `/auth` final.
# No agregar NEON_AUTH_JWKS_URL al frontend: esa clave pertenece a Render.
NEON_AUTH_BASE_URL=
